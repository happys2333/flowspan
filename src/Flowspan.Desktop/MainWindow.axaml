<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Flowspan.Desktop"
        x:Class="Flowspan.Desktop.MainWindow"
        x:DataType="vm:WorkspaceShellViewModel"
        x:Name="FlowspanMainWindow"
        Title="Flowspan — Continuous workspace"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="#161A1D"
        Foreground="#F2EFE6"
        FontFamily="Segoe UI Variable Text, Avenir Next, DejaVu Sans">
  <Window.Resources>
    <SolidColorBrush x:Key="GraphiteBrush" Color="#161A1D" />
    <SolidColorBrush x:Key="SteelBrush" Color="#252B30" />
    <SolidColorBrush x:Key="ChalkBrush" Color="#F2EFE6" />
    <SolidColorBrush x:Key="SafetyAmberBrush" Color="#F5B700" />
    <SolidColorBrush x:Key="SignalRedBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="CoolGrayBrush" Color="#AAB4BC" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontFamily"
              Value="Bahnschrift SemiCondensed, DIN Alternate, DejaVu Sans Condensed" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily"
              Value="Cascadia Mono, Menlo, DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{StaticResource CoolGrayBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{StaticResource SafetyAmberBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton:focus">
      <Setter Property="BorderBrush" Value="{StaticResource SafetyAmberBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox:focus">
      <Setter Property="BorderBrush" Value="{StaticResource SafetyAmberBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
  </Window.Styles>

  <Grid x:Name="WorkspaceRoot"
        ColumnDefinitions="252,*"
        AutomationProperties.Name="Flowspan continuous workspace">
    <Border Grid.Column="0"
            Background="{StaticResource SteelBrush}"
            BorderBrush="{StaticResource SafetyAmberBrush}"
            BorderThickness="0,0,2,0"
            Padding="24">
      <Grid RowDefinitions="Auto,32,Auto,24,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Classes="heading" FontSize="30" Text="FLOWSPAN" />
          <TextBlock Classes="label"
                     Foreground="{StaticResource SafetyAmberBrush}"
                     Text="CONTINUITY CONTROL" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="10">
          <TextBlock Classes="label" Text="LOCAL DEVICE" />
          <TextBlock x:Name="LocalDeviceName"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Text="{Binding DeviceName}"
                     TextWrapping="Wrap"
                     AutomationProperties.Name="Local device name" />
          <TextBlock Classes="secondary"
                     Text="{Binding StartupStatus}"
                     AutomationProperties.Name="Local identity status" />
          <TextBlock Classes="secondary"
                     FontSize="13"
                     Text="{Binding StartupDescription}" />

          <ToggleButton x:Name="IdentityDetailsToggle"
                        Margin="0,8,0,0"
                        Content="{Binding IdentityDetailsActionLabel}"
                        Command="{Binding ToggleIdentityDetailsCommand}"
                        AutomationProperties.Name="{Binding IdentityDetailsActionLabel}"
                        AutomationProperties.HelpText="Show or hide the local Device ID and identity fingerprint." />

          <Border IsVisible="{Binding IsIdentityDetailsVisible}"
                  BorderBrush="{StaticResource CoolGrayBrush}"
                  BorderThickness="1"
                  Padding="12">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="DEVICE ID" />
              <SelectableTextBlock x:Name="DeviceIdValue"
                                   FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                   FontSize="12"
                                   Text="{Binding DeviceId}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Device ID" />
              <TextBlock Classes="label" Text="IDENTITY FINGERPRINT" />
              <SelectableTextBlock x:Name="FingerprintValue"
                                   FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                   FontSize="12"
                                   Text="{Binding Fingerprint}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Identity fingerprint" />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding IsTestMode}"
                  Background="{StaticResource SafetyAmberBrush}"
                  Padding="10">
            <TextBlock Foreground="{StaticResource GraphiteBrush}"
                       FontWeight="Bold"
                       Text="TEST MODE — identity is not persisted"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Test mode warning" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    IsVisible="{Binding IsStartupBlocked}"
                    Spacing="8"
                    AutomationProperties.Name="Identity recovery">
          <TextBlock Classes="label"
                     Foreground="{StaticResource SignalRedBrush}"
                     Text="RECOVERY REQUIRED" />
          <TextBlock Classes="secondary" Text="{Binding RecoveryAction}" />
          <Button x:Name="RetryIdentityButton"
                  Content="Retry identity"
                  Command="{Binding RetryIdentityCommand}"
                  AutomationProperties.Name="Retry local identity" />
        </StackPanel>

        <StackPanel Grid.Row="6" Spacing="4">
          <TextBlock Classes="label" Text="LOCAL FIRST" />
          <TextBlock Classes="secondary"
                     FontSize="12"
                     Text="No online account. No capture or input permission requested at launch." />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="#1D2226"
              BorderBrush="{StaticResource CoolGrayBrush}"
              BorderThickness="0,0,0,1"
              Padding="28,18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Classes="label" Text="SHARING STATE" />
            <TextBlock x:Name="SharingStatusText"
                       Classes="heading"
                       FontSize="22"
                       Text="NOT SHARING"
                       AutomationProperties.Name="Sharing state: Not sharing" />
            <TextBlock Classes="secondary"
                       Text="No peer can view or drive this device." />
          </StackPanel>
          <Button x:Name="EmergencyStopButton"
                  Grid.Column="1"
                  MinWidth="174"
                  Background="{StaticResource SignalRedBrush}"
                  BorderBrush="{StaticResource SignalRedBrush}"
                  Foreground="{StaticResource GraphiteBrush}"
                  FontWeight="Bold"
                  Content="EMERGENCY STOP"
                  IsEnabled="{Binding IsEmergencyStopAvailable}"
                  AutomationProperties.Name="Emergency stop"
                  AutomationProperties.HelpText="Unavailable while no sharing service is active in this build." />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,30,34,40" Spacing="28">
          <Grid ColumnDefinitions="7*,5*">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Classes="heading"
                         FontSize="42"
                         Text="Continuous workspace" />
              <TextBlock Classes="secondary"
                         FontSize="17"
                         MaxWidth="650"
                         HorizontalAlignment="Left"
                         Text="Continue intent and portable context across trusted computers. Unsupported application state remains on its source and is never described as migrated." />
            </StackPanel>
            <Border Grid.Column="1"
                    BorderBrush="{StaticResource SafetyAmberBrush}"
                    BorderThickness="3,0,0,0"
                    Padding="18,4,0,4">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="STARTUP PROTECTION" />
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding IdentityProtection}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Identity protection" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Background="#20262A"
                  BorderBrush="{StaticResource SafetyAmberBrush}"
                  BorderThickness="2"
                  Padding="26"
                  AutomationProperties.Name="Local pairing network">
            <Grid ColumnDefinitions="5*,7*">
              <StackPanel Grid.Column="0" Margin="0,0,26,0" Spacing="12">
                <TextBlock Classes="label"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           Text="LOCAL PAIRING" />
                <TextBlock Classes="heading"
                           FontSize="27"
                           Text="{Binding LocalPairing.Status}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding LocalPairing.Status}" />
                <TextBlock Classes="secondary"
                           Text="{Binding LocalPairing.StatusDescription}" />
                <TextBlock Classes="secondary"
                           FontSize="12"
                           Text="{Binding LocalPairing.PermissionEducation}" />
                <Button x:Name="ReviewLocalNetworkAccessButton"
                        IsVisible="{Binding LocalPairing.IsPermissionReviewActionVisible}"
                        Content="REVIEW LOCAL NETWORK ACCESS"
                        Command="{Binding LocalPairing.ReviewPermissionCommand}"
                        AutomationProperties.Name="Review local network access"
                        AutomationProperties.HelpText="Review what Flowspan exposes on the local network, possible platform prompts, and how to revoke access. Reviewing alone starts no networking." />
                <Border IsVisible="{Binding LocalPairing.IsPermissionReviewVisible}"
                        BorderBrush="{StaticResource SafetyAmberBrush}"
                        BorderThickness="2"
                        Padding="12"
                        AutomationProperties.Name="Local network permission review">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="PERMISSION PREFLIGHT" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding LocalPairing.PermissionPlatformName}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Local network permission platform" />
                    <TextBlock Classes="label" Text="DATA VISIBLE ON THIS LAN" />
                    <TextBlock x:Name="LocalNetworkDataExposureText"
                               Classes="secondary"
                               FontSize="12"
                               Text="{Binding LocalPairing.PermissionDataExposure}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Local network data exposure" />
                    <TextBlock Classes="label" Text="WHAT THE PLATFORM MAY DO" />
                    <TextBlock x:Name="LocalNetworkPromptExpectationText"
                               Classes="secondary"
                               FontSize="12"
                               Text="{Binding LocalPairing.PermissionPromptExpectation}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Local network prompt expectation" />
                    <TextBlock Classes="label" Text="HOW TO REVOKE" />
                    <TextBlock x:Name="LocalNetworkRevocationText"
                               Classes="secondary"
                               FontSize="12"
                               Text="{Binding LocalPairing.PermissionRevocationAction}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Local network revocation path" />
                    <CheckBox x:Name="LocalNetworkPermissionAcknowledgement"
                              IsChecked="{Binding LocalPairing.HasAcknowledgedPermissionReview, Mode=TwoWay}"
                              AutomationProperties.Name="Acknowledge local network exposure">
                      <TextBlock Text="I understand that this device becomes discoverable on the current local network."
                                 TextWrapping="Wrap" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button x:Name="EnableLocalPairingButton"
                              Content="ENABLE ON LOCAL NETWORK"
                              Command="{Binding LocalPairing.EnableCommand}"
                              AutomationProperties.Name="Enable local network after permission review"
                              AutomationProperties.HelpText="Starts the listener, discovery, advertisement, and trusted reconnect lifetime after the permission preflight is acknowledged." />
                      <Button x:Name="CancelLocalNetworkPermissionReviewButton"
                              Content="Cancel"
                              Command="{Binding LocalPairing.CancelPermissionReviewCommand}"
                              AutomationProperties.Name="Cancel local network permission review" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label"
                           Text="{Binding LocalPairing.ListenerStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Local pairing listener status" />
                <TextBlock Foreground="{StaticResource SignalRedBrush}"
                           Text="{Binding LocalPairing.RecoveryAction}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Local pairing recovery action" />
                <Button x:Name="DisableLocalPairingButton"
                        Content="Disable"
                        Command="{Binding LocalPairing.DisableCommand}"
                        AutomationProperties.Name="Disable local pairing" />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Classes="label" Text="TRUSTED PEER CHANNELS" />
                <TextBlock Classes="secondary"
                           FontSize="12"
                           Text="Per-peer state for the explicitly enabled local network. Authenticated idle is not sharing." />
                <TextBlock Classes="secondary"
                           IsVisible="{Binding !LocalPairing.HasTrustedPeerConnections}"
                           Text="No current Trust Record has a local connection status." />
                <TextBlock x:Name="TrustedPeerIdentityWarningSummary"
                           IsVisible="{Binding LocalPairing.HasIdentityWarnings}"
                           Foreground="{StaticResource SignalRedBrush}"
                           FontWeight="SemiBold"
                           Text="IDENTITY CLAIM BLOCKED — review the expected and conflicting fingerprints below. Trust was preserved."
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Trusted peer identity warning" />
                <ListBox x:Name="TrustedPeerConnectionList"
                         IsVisible="{Binding LocalPairing.HasTrustedPeerConnections}"
                         ItemsSource="{Binding LocalPairing.TrustedPeerConnections}"
                         MaxHeight="240"
                         AutomationProperties.Name="Trusted peer local connection status">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrustedPeerConnectionItemViewModel">
                      <Border Margin="4"
                              BorderBrush="{StaticResource CoolGrayBrush}"
                              BorderThickness="1"
                              Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding DisplayName}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="11"
                                     Text="{Binding DeviceId}"
                                     TextWrapping="Wrap" />
                          <TextBlock Foreground="{StaticResource SafetyAmberBrush}"
                                     FontWeight="SemiBold"
                                     Text="{Binding Status}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding StatusDescription}"
                                     TextWrapping="Wrap" />
                          <Border IsVisible="{Binding HasIdentityWarning}"
                                  BorderBrush="{StaticResource SignalRedBrush}"
                                  BorderThickness="2"
                                  Padding="9"
                                  AutomationProperties.Name="Blocked trusted peer identity claim">
                            <StackPanel Spacing="4">
                              <TextBlock Foreground="{StaticResource SignalRedBrush}"
                                         FontWeight="SemiBold"
                                         Text="{Binding IdentityWarning}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="label" Text="TRUSTED FINGERPRINT" />
                              <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                   FontSize="10"
                                                   Text="{Binding ExpectedFingerprint}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Expected trusted peer fingerprint" />
                              <TextBlock Classes="label" Text="CONFLICTING ADVERTISED FINGERPRINT" />
                              <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                   FontSize="10"
                                                   Text="{Binding ConflictingFingerprint}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Conflicting advertised peer fingerprint" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Classes="label" Text="OBSERVED CANDIDATES" />
                <TextBlock Classes="secondary"
                           FontSize="12"
                           Text="Discovery metadata is unverified until the connected identity verifies the signed offer and both users compare the SAS." />
                <ListBox x:Name="LocalPairingCandidateList"
                         ItemsSource="{Binding LocalPairing.Candidates}"
                         SelectedItem="{Binding LocalPairing.SelectedCandidate, Mode=TwoWay}"
                         MaxHeight="210"
                         AutomationProperties.Name="Discovered local pairing candidates">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalPairingCandidateItemViewModel">
                      <Grid Margin="8" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding DisplayName}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="11"
                                     Text="{Binding DeviceId}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding EndPoint}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   Foreground="{StaticResource SafetyAmberBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding Status}"
                                   TextWrapping="Wrap"
                                   MaxWidth="210" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border IsVisible="{Binding LocalPairing.HasSelection}"
                        BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="1"
                        Padding="14"
                        AutomationProperties.Name="Selected local pairing candidate">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="SELECTED DISCOVERY RECORD" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding LocalPairing.SelectedCandidate.Status}"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="label" Text="IDENTITY FINGERPRINT" />
                    <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                         FontSize="11"
                                         Text="{Binding LocalPairing.SelectedCandidate.Fingerprint}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="Advertised unverified identity fingerprint" />
                    <TextBlock Classes="secondary"
                               FontSize="11"
                               Text="{Binding LocalPairing.SelectedCandidate.ExpiresAt, StringFormat='Offer expires {0}'}" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="PairDiscoveredDeviceButton"
                          Content="PAIR DEVICE"
                          Command="{Binding LocalPairing.PairDeviceCommand}"
                          AutomationProperties.Name="Pair selected local device"
                          AutomationProperties.HelpText="Available only for an unverified candidate that is not blocked by an existing Trust Record." />
                  <Button x:Name="CancelOutboundPairingButton"
                          Content="Cancel pairing"
                          Command="{Binding LocalPairing.CancelPairingCommand}"
                          AutomationProperties.Name="Cancel outbound pairing" />
                </StackPanel>
                <TextBlock Classes="secondary"
                           Text="{Binding LocalPairing.PairingStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Outbound pairing result" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="7*,5*">
            <Border Grid.Column="0"
                    Background="{StaticResource SteelBrush}"
                    BorderBrush="{StaticResource CoolGrayBrush}"
                    BorderThickness="1"
                    Padding="26"
                    Margin="0,0,12,0">
              <StackPanel MinHeight="310" Spacing="22">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label"
                             Foreground="{StaticResource SafetyAmberBrush}"
                             Text="PRIMARY WORKSPACE" />
                  <TextBlock Classes="heading" FontSize="30" Text="Activities" />
                </StackPanel>
                <Border BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,22,0,0">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="label" Text="NEW PORTABLE NOTE" />
                      <TextBlock Classes="secondary"
                                 Text="Create a bounded workspace.note/v1 Activity. This does not inspect another application's unsaved state." />
                      <TextBlock Text="Title" />
                      <TextBox x:Name="WorkspaceNoteTitleTextBox"
                               Text="{Binding Activities.DraftTitle, Mode=TwoWay}"
                               MaxLength="120"
                               AutomationProperties.Name="Portable note title" />
                      <TextBlock Text="Plain-text note" />
                      <TextBox x:Name="WorkspaceNoteBodyTextBox"
                               Text="{Binding Activities.DraftText, Mode=TwoWay}"
                               AcceptsReturn="True"
                               MinHeight="88"
                               MaxLength="16384"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Portable note body" />
                      <Button x:Name="CreateWorkspaceNoteButton"
                              Content="CREATE PORTABLE NOTE"
                              Command="{Binding Activities.CreateWorkspaceNoteCommand}"
                              IsEnabled="{Binding Activities.IsNoteCreationAvailable}"
                              AutomationProperties.Name="Create portable note Activity" />
                      <TextBlock Classes="secondary"
                                 Text="{Binding Activities.CreationStatus}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Portable note creation result" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="6">
                        <TextBlock Classes="label" Text="LOCAL ACTIVITIES" />
                        <ListBox x:Name="ActivityList"
                                 ItemsSource="{Binding Activities.Activities}"
                                 SelectedItem="{Binding Activities.SelectedActivity, Mode=TwoWay}"
                                 MaxHeight="190"
                                 AutomationProperties.Name="Local semantic Activities">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopActivitySnapshot">
                              <StackPanel Margin="8" Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="secondary"
                                           FontSize="11"
                                           Text="{Binding Kind}" />
                                <TextBlock Classes="secondary"
                                           FontSize="11"
                                           Text="{Binding Sensitivity}" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>

                      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="6">
                        <TextBlock Classes="label" Text="AUTHENTICATED TARGET" />
                        <ListBox x:Name="ActivityTargetList"
                                 ItemsSource="{Binding Activities.Targets}"
                                 SelectedItem="{Binding Activities.SelectedTarget, Mode=TwoWay}"
                                 MaxHeight="190"
                                 AutomationProperties.Name="Authenticated semantic Activity targets">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopActivityTargetSnapshot">
                              <StackPanel Margin="8" Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="secondary"
                                           FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                           FontSize="11"
                                           Text="{Binding DeviceId}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource SafetyAmberBrush}"
                            BorderThickness="2"
                            Padding="14"
                            AutomationProperties.Name="Semantic handoff preview">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="ActivityPreviewStatusText"
                                   Classes="label"
                                   Foreground="{StaticResource SafetyAmberBrush}"
                                   Text="{Binding Activities.PreviewStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Semantic handoff preview status" />
                        <TextBlock Text="{Binding Activities.PreviewDescription}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ActivityDataDisclosureText"
                                   Classes="secondary"
                                   Text="{Binding Activities.DataDisclosure}"
                                   AutomationProperties.Name="Semantic handoff data disclosure" />
                        <TextBlock x:Name="ActivityDegradationStatusText"
                                   Classes="label"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   Text="{Binding Activities.DegradationStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Semantic handoff degradation status" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.DegradationDescription}" />
                        <Button x:Name="ActivityHandoffButton"
                                Content="HAND OFF COPY"
                                Command="{Binding Activities.HandoffCommand}"
                                IsEnabled="{Binding Activities.IsHandoffAvailable}"
                                AutomationProperties.Name="Confirm semantic handoff copy"
                                AutomationProperties.HelpText="Creates a semantic copy on the selected authenticated target and keeps the source open." />
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource SignalRedBrush}"
                            BorderThickness="2"
                            Padding="14"
                            AutomationProperties.Name="Semantic move preview">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="ActivityMovePreviewStatusText"
                                   Classes="label"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   Text="{Binding Activities.MovePreviewStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Semantic move preview status" />
                        <TextBlock Text="{Binding Activities.MovePreviewDescription}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="ActivityMoveButton"
                                Content="MOVE AFTER TARGET ACK"
                                Command="{Binding Activities.MoveCommand}"
                                IsEnabled="{Binding Activities.IsMoveAvailable}"
                                AutomationProperties.Name="Confirm semantic move after target acknowledgement"
                                AutomationProperties.HelpText="Resumes the Activity on the selected authenticated target first, then closes the source only after a verified target acknowledgement." />
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource SignalRedBrush}"
                            BorderThickness="4,1,1,1"
                            Padding="14"
                            AutomationProperties.Name="Preview-only destructive Replace workflow">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="label"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   Text="REPLACE / PREVIEW ONLY" />
                        <TextBlock Classes="secondary"
                                   Text="Query a purpose-scoped, payload-free target inventory. This build does not activate destructive Replace from the desktop."
                                   TextWrapping="Wrap" />
                        <Button x:Name="ReviewReplaceTargetsButton"
                                Content="LOAD / REFRESH REPLACE TARGETS"
                                Command="{Binding Activities.RefreshReplaceTargetsCommand}"
                                IsEnabled="{Binding Activities.IsReplaceInventoryAvailable}"
                                AutomationProperties.Name="Load or refresh Replace target inventory"
                                AutomationProperties.HelpText="Queries eligible same-kind target snapshots from the selected authenticated device. It sends no destructive Replace request." />
                        <TextBlock x:Name="ReplaceInventoryStatusText"
                                   Classes="label"
                                   Text="{Binding Activities.ReplaceInventoryStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Replace target inventory status" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.ReplaceInventoryDescription}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Replace target inventory recovery guidance" />
                        <Grid ColumnDefinitions="5*,7*">
                          <TextBlock Grid.Column="0"
                                     Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding Activities.ReplaceInventoryCoverage}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Replace target inventory coverage" />
                          <TextBlock Grid.Column="1"
                                     Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="10"
                                     Text="{Binding Activities.ReplaceInventoryCapturedAt, StringFormat='Captured: {0}'}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Replace target inventory capture time" />
                        </Grid>
                        <ListBox x:Name="ReplaceTargetList"
                                 ItemsSource="{Binding Activities.ReplaceTargets}"
                                 SelectedItem="{Binding Activities.SelectedReplaceTarget, Mode=TwoWay}"
                                 MaxHeight="190"
                                 AutomationProperties.Name="Replace-eligible Activities on selected target device">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopReplaceTargetSnapshot">
                              <Grid Margin="8" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                  <TextBlock FontWeight="SemiBold"
                                             Text="{Binding Title}"
                                             TextWrapping="Wrap" />
                                  <TextBlock Classes="secondary"
                                             FontSize="11"
                                             Text="{Binding Kind}" />
                                  <TextBlock Classes="secondary"
                                             FontSize="11"
                                             Text="{Binding PlacementSlot, StringFormat='Placement: {0}'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            HorizontalAlignment="Right"
                                            Spacing="3">
                                  <TextBlock Classes="label"
                                             Text="{Binding Revision, StringFormat='REV {0}'}" />
                                  <TextBlock Classes="secondary"
                                             FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                             FontSize="9"
                                             Text="{Binding DescriptorDigest}"
                                             MaxWidth="150"
                                             TextTrimming="CharacterEllipsis"
                                             AutomationProperties.Name="Target descriptor digest" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Border IsVisible="{Binding Activities.IsReplacePreviewVisible}"
                                BorderBrush="{StaticResource SignalRedBrush}"
                                BorderThickness="1"
                                Padding="12"
                                AutomationProperties.Name="Exact destructive Replace comparison">
                          <StackPanel Spacing="10">
                            <TextBlock Classes="label"
                                       Foreground="{StaticResource SignalRedBrush}"
                                       Text="{Binding Activities.ReplacePreviewStatus}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Replace preview status" />
                            <Grid ColumnDefinitions="5*,Auto,7*">
                              <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="label" Text="INCOMING" />
                                <TextBlock x:Name="ReplaceIncomingDescriptionText"
                                           Text="{Binding Activities.ReplaceIncomingDescription}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Incoming Replace Activity" />
                              </StackPanel>
                              <Border Grid.Column="1"
                                      Margin="10,0"
                                      BorderBrush="{StaticResource SignalRedBrush}"
                                      BorderThickness="1,0,0,0" />
                              <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="label"
                                           Foreground="{StaticResource SignalRedBrush}"
                                           Text="REPLACED TARGET" />
                                <TextBlock x:Name="ReplaceTargetDescriptionText"
                                           Text="{Binding Activities.ReplaceTargetDescription}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Exact Activity that would be replaced" />
                              </StackPanel>
                            </Grid>
                            <CheckBox x:Name="ReplaceConfirmationCheckBox"
                                      IsChecked="{Binding Activities.HasAcknowledgedReplace, Mode=TwoWay}"
                                      IsEnabled="{Binding Activities.IsReplaceConfirmationAvailable}"
                                      AutomationProperties.Name="{Binding Activities.ReplaceConfirmationAutomationName}"
                                      AutomationProperties.HelpText="Confirmation applies only to the currently displayed device, target Activity ID, revision, and descriptor digest and is revoked on refresh.">
                              <TextBlock Text="{Binding Activities.ReplaceConfirmationDescription}"
                                         TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock x:Name="ReplaceActivationStatusText"
                                       Classes="label"
                                       Foreground="{StaticResource SignalRedBrush}"
                                       Text="{Binding Activities.ReplaceActivationStatus}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Destructive Replace activation status" />
                            <Button x:Name="DestructiveReplaceButton"
                                    Content="DESTRUCTIVE REPLACE NOT ACTIVATED"
                                    IsEnabled="{Binding Activities.IsDestructiveReplaceAvailable}"
                                    AutomationProperties.Name="Destructive Replace is not activated"
                                    AutomationProperties.HelpText="Blocked until receipt and recovery presentation plus target-local visible undo are complete." />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding Activities.IsReceiptVisible}"
                            BorderBrush="{StaticResource CoolGrayBrush}"
                            BorderThickness="1"
                            Padding="14"
                            AutomationProperties.Name="Semantic Activity operation receipt">
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="ActivityReceiptStatusText"
                                   Classes="label"
                                   Text="{Binding Activities.ReceiptStatus}"
                                   AutomationProperties.Name="Semantic Activity operation receipt status" />
                        <TextBlock Text="{Binding Activities.ReceiptSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.ReceiptReason, StringFormat='Reason: {0}'}" />
                        <SelectableTextBlock Classes="secondary"
                                             FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                             FontSize="11"
                                             Text="{Binding Activities.ReceiptCorrelationId, StringFormat='Correlation: {0}'}"
                                             TextWrapping="Wrap"
                                             AutomationProperties.Name="Semantic Activity operation correlation ID" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.ReceiptOccurredAt, StringFormat='Occurred: {0}'}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.UndoDescription}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#20262A"
                    BorderBrush="{StaticResource CoolGrayBrush}"
                    BorderThickness="1"
                    Padding="24"
                    Margin="12,0,0,0">
              <StackPanel MinHeight="310" Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="LOCAL NETWORK" />
                  <TextBlock Classes="heading" FontSize="27" Text="Trusted devices" />
                </StackPanel>
                <Border BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,16,0,0">
                  <StackPanel Spacing="10">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{Binding TrustedDevices.Status}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding TrustedDevices.Status}" />
                    <TextBlock Classes="secondary"
                               Text="{Binding TrustedDevices.StatusDescription}" />
                    <TextBlock Classes="label"
                               Foreground="{StaticResource SafetyAmberBrush}"
                               Text="{Binding TrustedDevices.Protection}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Trust Store protection" />
                    <TextBlock Classes="secondary"
                               IsVisible="{Binding TrustedDevices.IsEmpty}"
                               Text="{Binding TrustedDevices.RecoveryAction}" />

                    <StackPanel IsVisible="{Binding TrustedDevices.IsTrustAvailable}"
                                Spacing="12">
                      <TextBlock x:Name="DeviceEmptyState"
                                 IsVisible="{Binding TrustedDevices.IsEmpty}"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Text="No paired device has a persisted Trust Record."
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Trusted devices status: No paired devices" />

                      <ListBox x:Name="TrustedDeviceList"
                               ItemsSource="{Binding TrustedDevices.Devices}"
                               SelectedItem="{Binding TrustedDevices.SelectedDevice, Mode=TwoWay}"
                               MaxHeight="220"
                               AutomationProperties.Name="Paired devices">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="8" Spacing="3">
                              <TextBlock FontWeight="SemiBold"
                                         Text="{Binding DisplayName}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="secondary"
                                         FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                         FontSize="11"
                                         Text="{Binding DeviceId}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="secondary"
                                         FontSize="11"
                                         Text="{Binding CapabilitySummary}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <Border IsVisible="{Binding TrustedDevices.HasSelection}"
                              IsEnabled="{Binding TrustedDevices.CanEditSelectedPeer}"
                              BorderBrush="{StaticResource CoolGrayBrush}"
                              BorderThickness="1"
                              Padding="14">
                        <StackPanel Spacing="10">
                          <TextBlock Classes="label" Text="SELECTED TRUST RECORD" />
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding TrustedDevices.SelectedDevice.DisplayName}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Selected paired device" />
                          <TextBlock Classes="label" Text="DEVICE ID" />
                          <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                               FontSize="11"
                                               Text="{Binding TrustedDevices.SelectedDevice.DeviceId}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Selected peer Device ID" />
                          <TextBlock Classes="label" Text="IDENTITY FINGERPRINT" />
                          <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                               FontSize="11"
                                               Text="{Binding TrustedDevices.SelectedDevice.Fingerprint}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Selected peer identity fingerprint" />
                          <TextBlock Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding TrustedDevices.SelectedDevice.VerifiedAt, StringFormat='Verified {0}'}"
                                     AutomationProperties.Name="Trust verification time" />

                          <TextBlock Classes="label" Text="LOCAL CAPABILITY GRANT" />
                          <TextBlock Classes="secondary"
                                     FontSize="12"
                                     Text="A grant permits a class of peer request. It does not start sharing or request an operating-system permission." />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantActivityOffer, Mode=TwoWay}"
                                    Content="activity.offer — allow this peer to send Activities to this device"
                                    AutomationProperties.Name="Allow peer to offer Activities" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantActivityReceive, Mode=TwoWay}"
                                    Content="activity.receive — allow this peer to receive Activities from this device"
                                    AutomationProperties.Name="Allow peer to receive Activities" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantActivityReplace, Mode=TwoWay}"
                                    Content="activity.replace — replace Activities"
                                    AutomationProperties.Name="Allow peer to replace Activities" />
                          <CheckBox x:Name="GrantMirrorViewCheckBox"
                                    IsChecked="{Binding TrustedDevices.GrantMirrorView, Mode=TwoWay}"
                                    Content="mirror.view — view mirrored Activities"
                                    AutomationProperties.Name="Allow peer to view mirrored Activities" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantMirrorDrive, Mode=TwoWay}"
                                    Content="mirror.drive — drive mirrored Activities"
                                    AutomationProperties.Name="Allow peer to drive mirrored Activities" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantFileReceive, Mode=TwoWay}"
                                    Content="file.receive — receive files"
                                    AutomationProperties.Name="Allow peer to receive files" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantSceneApply, Mode=TwoWay}"
                                    Content="scene.apply — apply Scenes"
                                    AutomationProperties.Name="Allow peer to apply Scenes" />

                          <Button x:Name="SaveCapabilitiesButton"
                                  Content="SAVE CAPABILITIES"
                                  Command="{Binding TrustedDevices.SaveCapabilitiesCommand}"
                                  AutomationProperties.Name="Save peer capabilities" />

                          <Button x:Name="ReviewRevokeButton"
                                  Content="Review revoke"
                                  Command="{Binding TrustedDevices.BeginRevokeCommand}"
                                  AutomationProperties.Name="Review device revocation" />
                          <Border IsVisible="{Binding TrustedDevices.IsRevokeConfirmationVisible}"
                                  BorderBrush="{StaticResource SignalRedBrush}"
                                  BorderThickness="2"
                                  Padding="12"
                                  AutomationProperties.Name="Device revocation confirmation">
                            <StackPanel Spacing="10">
                              <TextBlock Foreground="{StaticResource SignalRedBrush}"
                                         FontWeight="SemiBold"
                                         Text="{Binding TrustedDevices.RevokeConfirmation}"
                                         TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Cancel"
                                        Command="{Binding TrustedDevices.CancelRevokeCommand}"
                                        AutomationProperties.Name="Cancel device revocation" />
                                <Button x:Name="ConfirmRevokeButton"
                                        Background="{StaticResource SignalRedBrush}"
                                        BorderBrush="{StaticResource SignalRedBrush}"
                                        Foreground="{StaticResource GraphiteBrush}"
                                        Content="REVOKE DEVICE"
                                        Command="{Binding TrustedDevices.ConfirmRevokeCommand}"
                                        AutomationProperties.Name="Revoke paired device" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                      <TextBlock x:Name="TrustMutationStatusText"
                                 Classes="secondary"
                                 Text="{Binding TrustedDevices.MutationStatus}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Trust mutation result" />
                      <TextBlock Classes="secondary"
                                 FontSize="12"
                                 Text="{Binding TrustedDevices.MutationDescription}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Trust mutation details" />
                    </StackPanel>

                    <TextBlock Classes="secondary"
                               FontSize="12"
                               Text="{Binding Pairing.Status}"
                               AutomationProperties.Name="Pairing readiness" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>

          <Border IsVisible="{Binding Pairing.HasPendingPrompt}"
                  Background="{StaticResource SteelBrush}"
                  BorderBrush="{StaticResource SafetyAmberBrush}"
                  BorderThickness="2"
                  Padding="28"
                  AutomationProperties.Name="Pairing confirmation required">
            <Grid ColumnDefinitions="7*,5*">
              <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,24,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label"
                             Foreground="{StaticResource SafetyAmberBrush}"
                             Text="PAIRING CONFIRMATION" />
                  <TextBlock Classes="heading"
                             FontSize="30"
                             Text="{Binding Pairing.PeerDisplayName}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Pairing peer name" />
                  <TextBlock Classes="secondary"
                             Text="Compare this code on both devices. A matching code verifies the identities; it does not start sharing." />
                </StackPanel>

                <TextBlock x:Name="PairingCodeValue"
                           Classes="heading"
                           FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                           FontSize="46"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           LetterSpacing="4"
                           Text="{Binding Pairing.PairingCode}"
                           AutomationProperties.Name="Pairing code" />

                <CheckBox x:Name="PairingCodeConfirmation"
                          IsChecked="{Binding Pairing.IsCodeConfirmed, Mode=TwoWay}"
                          Content="I compared this code on both devices"
                          AutomationProperties.Name="I compared the pairing code on both devices"
                          AutomationProperties.HelpText="Required before confirming pairing." />

                <Border BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="1"
                        Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="LOCAL CAPABILITY GRANT" />
                    <TextBlock Classes="secondary"
                               Text="Start with no access. These options do not request operating-system permissions." />
                    <CheckBox x:Name="GrantActivityOfferCheckBox"
                              IsChecked="{Binding Pairing.GrantActivityOffer, Mode=TwoWay}"
                              Content="Allow this peer to send Activities to this device"
                              AutomationProperties.Name="Allow peer to offer Activities" />
                    <CheckBox x:Name="GrantActivityReceiveCheckBox"
                              IsChecked="{Binding Pairing.GrantActivityReceive, Mode=TwoWay}"
                              Content="Allow this peer to receive Activities from this device"
                              AutomationProperties.Name="Allow peer to receive Activities" />
                    <TextBlock Classes="secondary"
                               FontSize="12"
                               Text="{Binding Pairing.CapabilitySummary}"
                               AutomationProperties.Name="Selected pairing capabilities" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button x:Name="RejectPairingButton"
                          MinWidth="150"
                          Content="Reject"
                          Command="{Binding Pairing.RejectPairingCommand}"
                          AutomationProperties.Name="Reject pairing" />
                  <Button x:Name="AcceptPairingButton"
                          MinWidth="190"
                          Background="{StaticResource SafetyAmberBrush}"
                          BorderBrush="{StaticResource SafetyAmberBrush}"
                          Foreground="{StaticResource GraphiteBrush}"
                          FontWeight="Bold"
                          Content="CONFIRM PAIRING"
                          IsEnabled="{Binding Pairing.CanAcceptPairing}"
                          Command="{Binding Pairing.AcceptPairingCommand}"
                          AutomationProperties.Name="Confirm pairing"
                          AutomationProperties.HelpText="Enabled only after the code comparison is confirmed." />
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="1"
                      BorderBrush="{StaticResource CoolGrayBrush}"
                      BorderThickness="1,0,0,0"
                      Padding="24,0,0,0">
                <StackPanel Spacing="12">
                  <TextBlock Classes="label" Text="VERIFIED REQUEST DETAILS" />
                  <TextBlock Classes="label" Text="DEVICE ID" />
                  <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                       FontSize="12"
                                       Text="{Binding Pairing.PeerDeviceId}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Pairing peer Device ID" />
                  <TextBlock Classes="label" Text="IDENTITY FINGERPRINT" />
                  <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                       FontSize="12"
                                       Text="{Binding Pairing.PeerFingerprint}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Pairing peer identity fingerprint" />
                  <TextBlock Classes="label" Text="PROTOCOL" />
                  <TextBlock Text="{Binding Pairing.PairingProtocol}"
                             AutomationProperties.Name="Pairing protocol version" />
                  <TextBlock Classes="label" Text="EXPIRES" />
                  <TextBlock Text="{Binding Pairing.PairingExpiresAt}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Pairing request expiry" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

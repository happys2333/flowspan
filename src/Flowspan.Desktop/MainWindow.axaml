<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Flowspan.Desktop"
        x:Class="Flowspan.Desktop.MainWindow"
        x:DataType="vm:WorkspaceShellViewModel"
        x:Name="FlowspanMainWindow"
        Title="{DynamicResource MainWindow_Title}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="#161A1D"
        Foreground="#F2EFE6"
        FontFamily="Segoe UI Variable Text, Avenir Next, DejaVu Sans">
  <Window.Resources>
    <SolidColorBrush x:Key="GraphiteBrush" Color="#161A1D" />
    <SolidColorBrush x:Key="SteelBrush" Color="#252B30" />
    <SolidColorBrush x:Key="ChalkBrush" Color="#F2EFE6" />
    <SolidColorBrush x:Key="SafetyAmberBrush" Color="#F5B700" />
    <SolidColorBrush x:Key="SignalRedBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="CoolGrayBrush" Color="#AAB4BC" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontFamily"
              Value="Bahnschrift SemiCondensed, DIN Alternate, DejaVu Sans Condensed" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily"
              Value="Cascadia Mono, Menlo, DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{StaticResource CoolGrayBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{StaticResource SafetyAmberBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton:focus">
      <Setter Property="BorderBrush" Value="{StaticResource SafetyAmberBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox:focus">
      <Setter Property="BorderBrush" Value="{StaticResource SafetyAmberBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
  </Window.Styles>

  <Grid x:Name="WorkspaceRoot"
        ColumnDefinitions="252,*"
        AutomationProperties.Name="{DynamicResource MainWindow_FlowspanContinuousWorkspace_AutomationName}">
    <Border Grid.Column="0"
            Background="{StaticResource SteelBrush}"
            BorderBrush="{StaticResource SafetyAmberBrush}"
            BorderThickness="0,0,2,0"
            Padding="24">
      <Grid RowDefinitions="Auto,32,Auto,24,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Classes="heading" FontSize="30" Text="{DynamicResource MainWindow_Flowspan_Text}" />
          <TextBlock Classes="label"
                     Foreground="{StaticResource SafetyAmberBrush}"
                     Text="{DynamicResource MainWindow_ContinuityControl_Text}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="10">
          <TextBlock Classes="label" Text="{DynamicResource MainWindow_LocalDevice_Text}" />
          <TextBlock x:Name="LocalDeviceName"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Text="{Binding DeviceName}"
                     TextWrapping="Wrap"
                     AutomationProperties.Name="{DynamicResource MainWindow_LocalDeviceName_AutomationName}" />
          <TextBlock Classes="secondary"
                     Text="{Binding StartupStatus}"
                     AutomationProperties.Name="{DynamicResource MainWindow_LocalIdentityStatus_AutomationName}" />
          <TextBlock Classes="secondary"
                     FontSize="13"
                     Text="{Binding StartupDescription}" />

          <ToggleButton x:Name="IdentityDetailsToggle"
                        Margin="0,8,0,0"
                        Content="{Binding IdentityDetailsActionLabel}"
                        Command="{Binding ToggleIdentityDetailsCommand}"
                        AutomationProperties.Name="{Binding IdentityDetailsActionLabel}"
                        AutomationProperties.HelpText="{DynamicResource MainWindow_ShowOrHideTheLocalDeviceIdAnd_AutomationHelp}" />

          <Border IsVisible="{Binding IsIdentityDetailsVisible}"
                  BorderBrush="{StaticResource CoolGrayBrush}"
                  BorderThickness="1"
                  Padding="12">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="{DynamicResource MainWindow_DeviceId_Text}" />
              <SelectableTextBlock x:Name="DeviceIdValue"
                                   FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                   FontSize="12"
                                   Text="{Binding DeviceId}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_DeviceId_AutomationName}" />
              <TextBlock Classes="label" Text="{DynamicResource MainWindow_IdentityFingerprint_Text}" />
              <SelectableTextBlock x:Name="FingerprintValue"
                                   FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                   FontSize="12"
                                   Text="{Binding Fingerprint}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_IdentityFingerprint_AutomationName}" />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding IsTestMode}"
                  Background="{StaticResource SafetyAmberBrush}"
                  Padding="10">
            <TextBlock Foreground="{StaticResource GraphiteBrush}"
                       FontWeight="Bold"
                       Text="{DynamicResource MainWindow_TestModeIdentityIsNotPersisted_Text}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="{DynamicResource MainWindow_TestModeWarning_AutomationName}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    IsVisible="{Binding IsStartupBlocked}"
                    Spacing="8"
                    AutomationProperties.Name="{DynamicResource MainWindow_IdentityRecovery_AutomationName}">
          <TextBlock Classes="label"
                     Foreground="{StaticResource SignalRedBrush}"
                     Text="{DynamicResource MainWindow_RecoveryRequired_Text}" />
          <TextBlock Classes="secondary" Text="{Binding RecoveryAction}" />
          <Button x:Name="RetryIdentityButton"
                  Content="{DynamicResource MainWindow_RetryIdentity_Content}"
                  Command="{Binding RetryIdentityCommand}"
                  AutomationProperties.Name="{DynamicResource MainWindow_RetryLocalIdentity_AutomationName}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource MainWindow_LocalFirst_Text}" />
          <TextBlock Classes="secondary"
                     FontSize="12"
                     Text="{DynamicResource MainWindow_NoOnlineAccountNoCaptureOrInputPermission_Text}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="#1D2226"
              BorderBrush="{StaticResource CoolGrayBrush}"
              BorderThickness="0,0,0,1"
              Padding="28,18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Classes="label" Text="{DynamicResource MainWindow_SharingState_Text}" />
            <TextBlock x:Name="SharingStatusText"
                       Classes="heading"
                       FontSize="22"
                       Text="{Binding RemoteWindow.SharingStatus}"
                       AutomationProperties.Name="{Binding RemoteWindow.SharingAutomationName}" />
            <TextBlock Classes="secondary"
                       Text="{Binding RemoteWindow.SharingDescription}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="EmergencyStopButton"
                  Grid.Column="1"
                  MinWidth="174"
                  Background="{StaticResource SignalRedBrush}"
                  BorderBrush="{StaticResource SignalRedBrush}"
                  Foreground="{StaticResource GraphiteBrush}"
                  FontWeight="Bold"
                  Content="{DynamicResource MainWindow_EmergencyStop_Content}"
                  Command="{Binding RemoteWindow.EmergencyStopCommand}"
                  IsEnabled="{Binding RemoteWindow.IsEmergencyStopAvailable}"
                  AutomationProperties.Name="{DynamicResource MainWindow_EmergencyStop_AutomationName}"
                  AutomationProperties.HelpText="{Binding RemoteWindow.EmergencyStopHelpText}" />
        </Grid>
      </Border>

      <ScrollViewer x:Name="WorkspaceScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,30,34,40" Spacing="28">
          <Grid ColumnDefinitions="7*,5*">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Classes="heading"
                         FontSize="42"
                         Text="{DynamicResource MainWindow_ContinuousWorkspace_Text}" />
              <TextBlock Classes="secondary"
                         FontSize="17"
                         MaxWidth="650"
                         HorizontalAlignment="Left"
                         Text="{DynamicResource MainWindow_ContinueIntentAndPortableContextAcrossTrustedComputers_Text}" />
            </StackPanel>
            <Border Grid.Column="1"
                    BorderBrush="{StaticResource SafetyAmberBrush}"
                    BorderThickness="3,0,0,0"
                    Padding="18,4,0,4">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource MainWindow_StartupProtection_Text}" />
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding IdentityProtection}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_IdentityProtection_AutomationName}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border x:Name="RemoteWindowDetailBand"
                  BorderBrush="{StaticResource SafetyAmberBrush}"
                  BorderThickness="2,1"
                  Padding="18"
                  IsVisible="{Binding RemoteWindow.IsDetailVisible}"
                  AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowLiveSharingDetails_AutomationName}">
            <Grid ColumnDefinitions="7*,5*" ColumnSpacing="24">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Classes="label"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           Text="{DynamicResource MainWindow_RemoteWindowExecutionStaysOnSource_Text}" />
                <TextBlock Classes="heading"
                           FontSize="25"
                           Text="{Binding RemoteWindow.ActivityTitle}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowActivityTitle_AutomationName}" />
                <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="11"
                                     Text="{Binding RemoteWindow.ActivityId}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowActivityId_AutomationName}" />
                <TextBlock Text="{Binding RemoteWindow.SharingDescription}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowSourceExecutionAndSharingState_AutomationName}" />
                <TextBlock x:Name="RemoteWindowEmergencyStopResultText"
                           Classes="label"
                           Foreground="{StaticResource SignalRedBrush}"
                           Text="{Binding RemoteWindow.EmergencyStopStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowEmergencyStopResult_AutomationName}" />
                <TextBlock x:Name="RemoteWindowEmergencyStopDescriptionText"
                           Classes="secondary"
                           Text="{Binding RemoteWindow.EmergencyStopDescription}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="RemoteWindowLocalResetStatusText"
                           Classes="label"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           Text="{Binding RemoteWindow.LocalResetStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowLocalResetStatus_AutomationName}" />
                <TextBlock x:Name="RemoteWindowLocalResetDescriptionText"
                           Classes="secondary"
                           Text="{Binding RemoteWindow.LocalResetDescription}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowLocalResetGuidance_AutomationName}" />
                <Button x:Name="ConfirmLocalResetButton"
                        HorizontalAlignment="Left"
                        MinHeight="44"
                        Content="{DynamicResource MainWindow_ConfirmLocalReset_Content}"
                        Command="{Binding RemoteWindow.ResetRemoteWindowCommand}"
                        IsVisible="{Binding RemoteWindow.IsLocalResetAvailable}"
                        AutomationProperties.Name="{DynamicResource MainWindow_ConfirmLocalRemoteWindowReset_AutomationName}"
                        AutomationProperties.HelpText="{DynamicResource MainWindow_ConfirmsALocalResetToNotSharingThis_AutomationHelp}" />
              </StackPanel>
              <Grid Grid.Column="1"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="7">
                <TextBlock Grid.Row="0" Classes="label" Text="{Binding RemoteWindow.CaptureStatus}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowCaptureState_AutomationName}" />
                <TextBlock Grid.Row="1" Classes="label" Text="{Binding RemoteWindow.ParticipantStatus}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowParticipantCount_AutomationName}" />
                <TextBlock Grid.Row="2" Classes="label" Text="{Binding RemoteWindow.DriverStatus}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowDriverState_AutomationName}" />
                <TextBlock x:Name="RemoteWindowProtectionStatusText"
                           Grid.Row="3"
                           Classes="label"
                           Text="{Binding RemoteWindow.ProtectionStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowProtectionState_AutomationName}" />
                <TextBlock Grid.Row="4" Classes="label" Text="{Binding RemoteWindow.RevisionStatus}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowStateRevision_AutomationName}" />
              </Grid>
            </Grid>
          </Border>

          <Border x:Name="RemoteWindowPermissionBand"
                  Background="#1D2226"
                  BorderBrush="{StaticResource CoolGrayBrush}"
                  BorderThickness="0,1"
                  Padding="18"
                  AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowProgressivePermissions_AutomationName}">
            <Grid x:Name="RemoteWindowPermissionGrid"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="28">
              <StackPanel x:Name="CapturePermissionColumn"
                          Grid.Column="0"
                          Spacing="7">
                <TextBlock Classes="label"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           Text="{DynamicResource MainWindow_ScreenCapturePermission_Text}" />
                <TextBlock x:Name="CapturePermissionStatusText"
                           FontWeight="SemiBold"
                           Text="{Binding RemoteWindow.CapturePermissionStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_ScreenCapturePermissionStatus_AutomationName}" />
                <TextBlock Classes="secondary"
                           Text="{Binding RemoteWindow.CapturePermissionDescription}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="secondary"
                           Text="{Binding RemoteWindow.CapturePermissionRecoveryAction}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_ScreenCapturePermissionRecoveryAction_AutomationName}" />
                <Button x:Name="ReviewCapturePermissionButton"
                        IsVisible="{Binding RemoteWindow.IsCapturePermissionReviewActionVisible}"
                        Content="{DynamicResource MainWindow_ReviewCaptureAccess_Content}"
                        Command="{Binding RemoteWindow.ReviewCapturePermissionCommand}"
                        AutomationProperties.Name="{DynamicResource MainWindow_ReviewScreenCapturePermission_AutomationName}"
                        AutomationProperties.HelpText="{DynamicResource MainWindow_OpensThePermissionRationaleWithoutRequestingOperatingSystem_AutomationHelp}" />
                <StackPanel x:Name="CapturePermissionReviewBand"
                            IsVisible="{Binding RemoteWindow.IsCapturePermissionReviewVisible}"
                            Spacing="8"
                            AutomationProperties.Name="{DynamicResource MainWindow_ScreenCapturePermissionReview_AutomationName}">
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_ReviewBeforeRequest_Text}" />
                  <TextBlock x:Name="CapturePermissionRationaleText"
                             Classes="secondary"
                             Text="{DynamicResource MainWindow_RemoteWindowCanExposeTheSelectedActivityS_Text}"
                             TextWrapping="Wrap" />
                  <CheckBox x:Name="CapturePermissionAcknowledgement"
                            IsChecked="{Binding RemoteWindow.HasAcknowledgedCapturePermissionReview, Mode=TwoWay}"
                            Content="{DynamicResource MainWindow_IReviewedWhatScreenCaptureExposes_Content}"
                            AutomationProperties.Name="{DynamicResource MainWindow_AcknowledgeScreenCapturePermissionReview_AutomationName}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RequestCapturePermissionButton"
                            Content="{DynamicResource MainWindow_RequestCaptureAccess_Content}"
                            Command="{Binding RemoteWindow.RequestCapturePermissionCommand}"
                            AutomationProperties.Name="{DynamicResource MainWindow_RequestScreenCapturePermission_AutomationName}" />
                    <Button Content="{DynamicResource MainWindow_Cancel_Content}"
                            Command="{Binding RemoteWindow.CancelCapturePermissionReviewCommand}"
                            AutomationProperties.Name="{DynamicResource MainWindow_CancelScreenCapturePermissionReview_AutomationName}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="InputPermissionColumn"
                          Grid.Column="1"
                          Spacing="7">
                <TextBlock Classes="label"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           Text="{DynamicResource MainWindow_RemoteDriving_Text}" />
                <CheckBox x:Name="RemoteDrivingCheckBox"
                          IsChecked="{Binding RemoteWindow.IsRemoteDrivingEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding RemoteWindow.CanEnableRemoteDriving}"
                          Content="{DynamicResource MainWindow_EnableRemoteDriving_Content}"
                          AutomationProperties.Name="{DynamicResource MainWindow_EnableRemoteWindowDriving_AutomationName}"
                          AutomationProperties.HelpText="{DynamicResource MainWindow_EnablingDrivingOpensInputPermissionReviewItDoes_AutomationHelp}" />
                <TextBlock x:Name="InputPermissionStatusText"
                           FontWeight="SemiBold"
                           Text="{Binding RemoteWindow.InputPermissionStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_InputPermissionStatus_AutomationName}" />
                <TextBlock Classes="secondary"
                           Text="{Binding RemoteWindow.InputPermissionDescription}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="secondary"
                           Text="{Binding RemoteWindow.InputPermissionRecoveryAction}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_InputPermissionRecoveryAction_AutomationName}" />
                <StackPanel x:Name="InputPermissionReviewBand"
                            IsVisible="{Binding RemoteWindow.IsInputPermissionReviewVisible}"
                            Spacing="8"
                            AutomationProperties.Name="{DynamicResource MainWindow_InputPermissionReview_AutomationName}">
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_ReviewBeforeRequest_Text_02}" />
                  <TextBlock x:Name="InputPermissionRationaleText"
                             Classes="secondary"
                             Text="{DynamicResource MainWindow_RemoteDrivingCanExposeKeyboardPointerAndScroll_Text}"
                             TextWrapping="Wrap" />
                  <CheckBox x:Name="InputPermissionAcknowledgement"
                            IsChecked="{Binding RemoteWindow.HasAcknowledgedInputPermissionReview, Mode=TwoWay}"
                            Content="{DynamicResource MainWindow_IReviewedRemoteInputAccess_Content}"
                            AutomationProperties.Name="{DynamicResource MainWindow_AcknowledgeInputPermissionReview_AutomationName}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RequestInputPermissionButton"
                            Content="{DynamicResource MainWindow_RequestInputAccess_Content}"
                            Command="{Binding RemoteWindow.RequestInputPermissionCommand}"
                            AutomationProperties.Name="{DynamicResource MainWindow_RequestInputPermission_AutomationName}" />
                    <Button Content="{DynamicResource MainWindow_Cancel_Content_02}"
                            Command="{Binding RemoteWindow.CancelInputPermissionReviewCommand}"
                            AutomationProperties.Name="{DynamicResource MainWindow_CancelInputPermissionReview_AutomationName}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="7*,5*">
            <Border Grid.Column="0"
                    Background="{StaticResource SteelBrush}"
                    BorderBrush="{StaticResource CoolGrayBrush}"
                    BorderThickness="1"
                    Padding="24"
                    Margin="0,0,12,0">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label"
                             Foreground="{StaticResource SafetyAmberBrush}"
                             Text="{DynamicResource MainWindow_PrivateLocalData_Text}" />
                  <TextBlock Classes="heading" FontSize="27" Text="{DynamicResource MainWindow_OperationHistory_Text}" />
                </StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding LocalData.HistoryStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_OperationHistoryStatus_AutomationName}" />
                <TextBlock Classes="secondary"
                           Text="{Binding LocalData.HistoryDescription}"
                           TextWrapping="Wrap" />
                <Button x:Name="RefreshLocalDataButton"
                        MinHeight="44"
                        Content="{DynamicResource MainWindow_RefreshLocalData_Content}"
                        Command="{Binding LocalData.RefreshCommand}"
                        AutomationProperties.Name="{DynamicResource MainWindow_RefreshOperationHistoryAndDiagnostics_AutomationName}" />
                <ListBox x:Name="OperationHistoryList"
                         ItemsSource="{Binding LocalData.History}"
                         SelectedItem="{Binding LocalData.SelectedHistory, Mode=TwoWay}"
                         MaxHeight="230"
                         AutomationProperties.Name="{DynamicResource MainWindow_ProtectedOperationReceiptHistory_AutomationName}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="8" Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        <TextBlock Classes="secondary" Text="{Binding Kind}" />
                        <TextBlock Classes="secondary" Text="{Binding Status}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border IsVisible="{Binding LocalData.HasSelectedHistory}"
                        BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="1"
                        Padding="12"
                        AutomationProperties.Name="{DynamicResource MainWindow_SelectedRedactedOperationReceipt_AutomationName}">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_SelectedReceipt_Text}" />
                    <TextBlock Text="{Binding LocalData.SelectedHistory.Kind, StringFormat={StaticResource MainWindow_Format_HistoryKind}}" />
                    <TextBlock Text="{Binding LocalData.SelectedHistory.Status, StringFormat={StaticResource MainWindow_Format_HistoryStatus}}" />
                    <TextBlock Text="{Binding LocalData.SelectedHistory.FailureCode, StringFormat={StaticResource MainWindow_Format_Reason}}" />
                    <TextBlock Classes="secondary"
                               Text="{Binding LocalData.SelectedHistory.OccurredAt, StringFormat={StaticResource MainWindow_Format_Occurred}}" />
                    <TextBlock Classes="secondary"
                               Text="{Binding LocalData.SelectedHistory.RecordedAt, StringFormat={StaticResource MainWindow_Format_Recorded}}" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ExportHistoryButton"
                          MinHeight="44"
                          Content="{DynamicResource MainWindow_ExportRedactedHistory_Content}"
                          Command="{Binding LocalData.ExportHistoryCommand}"
                          AutomationProperties.Name="{DynamicResource MainWindow_ExportRedactedOperationHistory_AutomationName}" />
                  <Button x:Name="BeginDeleteHistoryButton"
                          MinHeight="44"
                          Content="{DynamicResource MainWindow_ReviewDelete_Content}"
                          Command="{Binding LocalData.BeginDeleteHistoryCommand}"
                          AutomationProperties.Name="{DynamicResource MainWindow_ReviewSelectedHistoryReceiptDeletion_AutomationName}" />
                  <Button x:Name="BeginClearHistoryButton"
                          MinHeight="44"
                          Content="{DynamicResource MainWindow_ReviewClearAll_Content}"
                          Command="{Binding LocalData.BeginClearHistoryCommand}"
                          AutomationProperties.Name="{DynamicResource MainWindow_ReviewClearingAllOperationHistory_AutomationName}" />
                </StackPanel>
                <Border IsVisible="{Binding LocalData.IsDeleteHistoryVisible}"
                        BorderBrush="{StaticResource SignalRedBrush}"
                        BorderThickness="2" Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding LocalData.HistoryDeleteConfirmation}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{DynamicResource MainWindow_Cancel_Content_03}"
                              Command="{Binding LocalData.CancelDeleteHistoryCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_CancelHistoryReceiptDeletion_AutomationName}" />
                      <Button x:Name="ConfirmDeleteHistoryButton"
                              Content="{DynamicResource MainWindow_DeleteReceipt_Content}"
                              Command="{Binding LocalData.ConfirmDeleteHistoryCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_DeleteSelectedHistoryReceipt_AutomationName}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border IsVisible="{Binding LocalData.IsClearHistoryVisible}"
                        BorderBrush="{StaticResource SignalRedBrush}"
                        BorderThickness="2" Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding LocalData.HistoryClearConfirmation}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{DynamicResource MainWindow_Cancel_Content_04}"
                              Command="{Binding LocalData.CancelClearHistoryCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_CancelClearingOperationHistory_AutomationName}" />
                      <Button x:Name="ConfirmClearHistoryButton"
                              Content="{DynamicResource MainWindow_DeleteAllReceipts_Content}"
                              Command="{Binding LocalData.ConfirmClearHistoryCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_DeleteAllOperationHistory_AutomationName}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Classes="secondary" FontSize="11"
                           Text="{Binding LocalData.HistoryExportPath}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_HistoryExportPath_AutomationName}" />
                <SelectableTextBlock Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="10" MaxHeight="130"
                                     Text="{Binding LocalData.HistoryExportPreview}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_RedactedHistoryExportPreview_AutomationName}" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#20262A"
                    BorderBrush="{StaticResource CoolGrayBrush}"
                    BorderThickness="1"
                    Padding="24"
                    Margin="12,0,0,0">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_SupportData_Text}" />
                  <TextBlock Classes="heading" FontSize="27" Text="{DynamicResource MainWindow_RedactedDiagnostics_Text}" />
                </StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding LocalData.DiagnosticsStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_RedactedDiagnosticsStatus_AutomationName}" />
                <TextBlock Classes="secondary"
                           Text="{DynamicResource MainWindow_VersionsActiveNegotiatedProtocolsAuthorizedCapabilitiesOperationStates_Text}" />
                <Button x:Name="ExportDiagnosticsButton"
                        MinHeight="44"
                        Content="{DynamicResource MainWindow_ExportRedactedDiagnostics_Content}"
                        Command="{Binding LocalData.ExportDiagnosticsCommand}"
                        AutomationProperties.Name="{DynamicResource MainWindow_ExportRedactedDiagnosticBundle_AutomationName}" />
                <TextBlock Classes="secondary" FontSize="11"
                           Text="{Binding LocalData.DiagnosticsExportPath}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_DiagnosticExportPath_AutomationName}" />
                <SelectableTextBlock Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="10" MaxHeight="220"
                                     Text="{Binding LocalData.DiagnosticsPreview}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_ExactRedactedDiagnosticPreview_AutomationName}" />
                <TextBlock Classes="label" Text="{DynamicResource MainWindow_LocalDiagnosticBundles_Text}" />
                <ListBox x:Name="DiagnosticExportList"
                         ItemsSource="{Binding LocalData.DiagnosticExports}"
                         SelectedItem="{Binding LocalData.SelectedDiagnosticExport, Mode=TwoWay}"
                         MaxHeight="150"
                         AutomationProperties.Name="{DynamicResource MainWindow_LocalRedactedDiagnosticBundleFiles_AutomationName}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="8"
                                 Classes="secondary"
                                 FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                 FontSize="10"
                                 Text="{Binding FileName}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="BeginDeleteDiagnosticButton"
                        MinHeight="44"
                        Content="{DynamicResource MainWindow_ReviewBundleDelete_Content}"
                        Command="{Binding LocalData.BeginDeleteDiagnosticCommand}"
                        AutomationProperties.Name="{DynamicResource MainWindow_ReviewSelectedDiagnosticBundleDeletion_AutomationName}" />
                <Border IsVisible="{Binding LocalData.IsDeleteDiagnosticVisible}"
                        BorderBrush="{StaticResource SignalRedBrush}"
                        BorderThickness="2" Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding LocalData.DiagnosticDeleteConfirmation}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{DynamicResource MainWindow_Cancel_Content_05}"
                              Command="{Binding LocalData.CancelDeleteDiagnosticCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_CancelDiagnosticBundleDeletion_AutomationName}" />
                      <Button x:Name="ConfirmDeleteDiagnosticButton"
                              Content="{DynamicResource MainWindow_DeleteBundle_Content}"
                              Command="{Binding LocalData.ConfirmDeleteDiagnosticCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_DeleteSelectedDiagnosticBundle_AutomationName}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>

          <Border Background="#20262A"
                  BorderBrush="{StaticResource SafetyAmberBrush}"
                  BorderThickness="2"
                  Padding="26"
                  AutomationProperties.Name="{DynamicResource MainWindow_LocalPairingNetwork_AutomationName}">
            <Grid ColumnDefinitions="5*,7*">
              <StackPanel Grid.Column="0" Margin="0,0,26,0" Spacing="12">
                <TextBlock Classes="label"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           Text="{DynamicResource MainWindow_LocalPairing_Text}" />
                <TextBlock Classes="heading"
                           FontSize="27"
                           Text="{Binding LocalPairing.Status}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding LocalPairing.Status}" />
                <TextBlock Classes="secondary"
                           Text="{Binding LocalPairing.StatusDescription}" />
                <TextBlock Classes="secondary"
                           FontSize="12"
                           Text="{Binding LocalPairing.PermissionEducation}" />
                <Button x:Name="ReviewLocalNetworkAccessButton"
                        IsVisible="{Binding LocalPairing.IsPermissionReviewActionVisible}"
                        Content="{DynamicResource MainWindow_ReviewLocalNetworkAccess_Content}"
                        Command="{Binding LocalPairing.ReviewPermissionCommand}"
                        AutomationProperties.Name="{DynamicResource MainWindow_ReviewLocalNetworkAccess_AutomationName}"
                        AutomationProperties.HelpText="{DynamicResource MainWindow_ReviewWhatFlowspanExposesOnTheLocalNetwork_AutomationHelp}" />
                <Border IsVisible="{Binding LocalPairing.IsPermissionReviewVisible}"
                        BorderBrush="{StaticResource SafetyAmberBrush}"
                        BorderThickness="2"
                        Padding="12"
                        AutomationProperties.Name="{DynamicResource MainWindow_LocalNetworkPermissionReview_AutomationName}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_PermissionPreflight_Text}" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding LocalPairing.PermissionPlatformName}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_LocalNetworkPermissionPlatform_AutomationName}" />
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_DataVisibleOnThisLan_Text}" />
                    <TextBlock x:Name="LocalNetworkDataExposureText"
                               Classes="secondary"
                               FontSize="12"
                               Text="{Binding LocalPairing.PermissionDataExposure}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_LocalNetworkDataExposure_AutomationName}" />
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_WhatThePlatformMayDo_Text}" />
                    <TextBlock x:Name="LocalNetworkPromptExpectationText"
                               Classes="secondary"
                               FontSize="12"
                               Text="{Binding LocalPairing.PermissionPromptExpectation}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_LocalNetworkPromptExpectation_AutomationName}" />
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_HowToRevoke_Text}" />
                    <TextBlock x:Name="LocalNetworkRevocationText"
                               Classes="secondary"
                               FontSize="12"
                               Text="{Binding LocalPairing.PermissionRevocationAction}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_LocalNetworkRevocationPath_AutomationName}" />
                    <CheckBox x:Name="LocalNetworkPermissionAcknowledgement"
                              IsChecked="{Binding LocalPairing.HasAcknowledgedPermissionReview, Mode=TwoWay}"
                              AutomationProperties.Name="{DynamicResource MainWindow_AcknowledgeLocalNetworkExposure_AutomationName}">
                      <TextBlock Text="{DynamicResource MainWindow_IUnderstandThatThisDeviceBecomesDiscoverableOn_Text}"
                                 TextWrapping="Wrap" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button x:Name="EnableLocalPairingButton"
                              Content="{DynamicResource MainWindow_EnableOnLocalNetwork_Content}"
                              Command="{Binding LocalPairing.EnableCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_EnableLocalNetworkAfterPermissionReview_AutomationName}"
                              AutomationProperties.HelpText="{DynamicResource MainWindow_StartsTheListenerDiscoveryAdvertisementAndTrustedReconnect_AutomationHelp}" />
                      <Button x:Name="CancelLocalNetworkPermissionReviewButton"
                              Content="{DynamicResource MainWindow_Cancel_Content_06}"
                              Command="{Binding LocalPairing.CancelPermissionReviewCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_CancelLocalNetworkPermissionReview_AutomationName}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Classes="label"
                           Text="{Binding LocalPairing.ListenerStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_LocalPairingListenerStatus_AutomationName}" />
                <TextBlock Foreground="{StaticResource SignalRedBrush}"
                           Text="{Binding LocalPairing.RecoveryAction}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_LocalPairingRecoveryAction_AutomationName}" />
                <Button x:Name="DisableLocalPairingButton"
                        Content="{DynamicResource MainWindow_Disable_Content}"
                        Command="{Binding LocalPairing.DisableCommand}"
                        AutomationProperties.Name="{DynamicResource MainWindow_DisableLocalPairing_AutomationName}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Classes="label" Text="{DynamicResource MainWindow_TrustedPeerChannels_Text}" />
                <TextBlock Classes="secondary"
                           FontSize="12"
                           Text="{DynamicResource MainWindow_PerPeerStateForTheExplicitlyEnabledLocal_Text}" />
                <TextBlock Classes="secondary"
                           IsVisible="{Binding !LocalPairing.HasTrustedPeerConnections}"
                           Text="{DynamicResource MainWindow_NoCurrentTrustRecordHasALocalConnection_Text}" />
                <TextBlock x:Name="TrustedPeerIdentityWarningSummary"
                           IsVisible="{Binding LocalPairing.HasIdentityWarnings}"
                           Foreground="{StaticResource SignalRedBrush}"
                           FontWeight="SemiBold"
                           Text="{DynamicResource MainWindow_IdentityClaimBlockedReviewTheExpectedAndConflicting_Text}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_TrustedPeerIdentityWarning_AutomationName}" />
                <ListBox x:Name="TrustedPeerConnectionList"
                         IsVisible="{Binding LocalPairing.HasTrustedPeerConnections}"
                         ItemsSource="{Binding LocalPairing.TrustedPeerConnections}"
                         MaxHeight="240"
                         AutomationProperties.Name="{DynamicResource MainWindow_TrustedPeerLocalConnectionStatus_AutomationName}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrustedPeerConnectionItemViewModel">
                      <Border Margin="4"
                              BorderBrush="{StaticResource CoolGrayBrush}"
                              BorderThickness="1"
                              Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding DisplayName}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="11"
                                     Text="{Binding DeviceId}"
                                     TextWrapping="Wrap" />
                          <TextBlock Foreground="{StaticResource SafetyAmberBrush}"
                                     FontWeight="SemiBold"
                                     Text="{Binding Status}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding StatusDescription}"
                                     TextWrapping="Wrap" />
                          <Border IsVisible="{Binding HasIdentityWarning}"
                                  BorderBrush="{StaticResource SignalRedBrush}"
                                  BorderThickness="2"
                                  Padding="9"
                                  AutomationProperties.Name="{DynamicResource MainWindow_BlockedTrustedPeerIdentityClaim_AutomationName}">
                            <StackPanel Spacing="4">
                              <TextBlock Foreground="{StaticResource SignalRedBrush}"
                                         FontWeight="SemiBold"
                                         Text="{Binding IdentityWarning}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="label" Text="{DynamicResource MainWindow_TrustedFingerprint_Text}" />
                              <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                   FontSize="10"
                                                   Text="{Binding ExpectedFingerprint}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="{DynamicResource MainWindow_ExpectedTrustedPeerFingerprint_AutomationName}" />
                              <TextBlock Classes="label" Text="{DynamicResource MainWindow_ConflictingAdvertisedFingerprint_Text}" />
                              <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                   FontSize="10"
                                                   Text="{Binding ConflictingFingerprint}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="{DynamicResource MainWindow_ConflictingAdvertisedPeerFingerprint_AutomationName}" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Classes="label" Text="{DynamicResource MainWindow_ObservedCandidates_Text}" />
                <TextBlock Classes="secondary"
                           FontSize="12"
                           Text="{DynamicResource MainWindow_DiscoveryMetadataIsUnverifiedUntilTheConnectedIdentity_Text}" />
                <ListBox x:Name="LocalPairingCandidateList"
                         ItemsSource="{Binding LocalPairing.Candidates}"
                         SelectedItem="{Binding LocalPairing.SelectedCandidate, Mode=TwoWay}"
                         MaxHeight="210"
                         AutomationProperties.Name="{DynamicResource MainWindow_DiscoveredLocalPairingCandidates_AutomationName}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalPairingCandidateItemViewModel">
                      <Grid Margin="8" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding DisplayName}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="11"
                                     Text="{Binding DeviceId}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding EndPoint}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   Foreground="{StaticResource SafetyAmberBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding Status}"
                                   TextWrapping="Wrap"
                                   MaxWidth="210" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border IsVisible="{Binding LocalPairing.HasSelection}"
                        BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="1"
                        Padding="14"
                        AutomationProperties.Name="{DynamicResource MainWindow_SelectedLocalPairingCandidate_AutomationName}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_SelectedDiscoveryRecord_Text}" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding LocalPairing.SelectedCandidate.Status}"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_IdentityFingerprint_Text_02}" />
                    <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                         FontSize="11"
                                         Text="{Binding LocalPairing.SelectedCandidate.Fingerprint}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{DynamicResource MainWindow_AdvertisedUnverifiedIdentityFingerprint_AutomationName}" />
                    <TextBlock Classes="secondary"
                               FontSize="11"
                               Text="{Binding LocalPairing.SelectedCandidate.ExpiresAt, StringFormat={StaticResource MainWindow_Format_OfferExpires}}" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="PairDiscoveredDeviceButton"
                          Content="{DynamicResource MainWindow_PairDevice_Content}"
                          Command="{Binding LocalPairing.PairDeviceCommand}"
                          AutomationProperties.Name="{DynamicResource MainWindow_PairSelectedLocalDevice_AutomationName}"
                          AutomationProperties.HelpText="{DynamicResource MainWindow_AvailableOnlyForAnUnverifiedCandidateThatIs_AutomationHelp}" />
                  <Button x:Name="CancelOutboundPairingButton"
                          Content="{DynamicResource MainWindow_CancelPairing_Content}"
                          Command="{Binding LocalPairing.CancelPairingCommand}"
                          AutomationProperties.Name="{DynamicResource MainWindow_CancelOutboundPairing_AutomationName}" />
                </StackPanel>
                <TextBlock Classes="secondary"
                           Text="{Binding LocalPairing.PairingStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource MainWindow_OutboundPairingResult_AutomationName}" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="7*,5*">
            <Border Grid.Column="0"
                    Background="{StaticResource SteelBrush}"
                    BorderBrush="{StaticResource CoolGrayBrush}"
                    BorderThickness="1"
                    Padding="26"
                    Margin="0,0,12,0">
              <StackPanel MinHeight="310" Spacing="22">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label"
                             Foreground="{StaticResource SafetyAmberBrush}"
                             Text="{DynamicResource MainWindow_PrimaryWorkspace_Text}" />
                  <TextBlock Classes="heading" FontSize="30" Text="{DynamicResource MainWindow_Activities_Text}" />
                </StackPanel>
                <Border BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,22,0,0">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="label" Text="{DynamicResource MainWindow_NewPortableNote_Text}" />
                      <TextBlock Classes="secondary"
                                 Text="{DynamicResource MainWindow_CreateABoundedWorkspaceNoteV1ActivityThis_Text}" />
                      <TextBlock Text="{DynamicResource MainWindow_Title_Text}" />
                      <TextBox x:Name="WorkspaceNoteTitleTextBox"
                               Text="{Binding Activities.DraftTitle, Mode=TwoWay}"
                               MaxLength="120"
                               AutomationProperties.Name="{DynamicResource MainWindow_PortableNoteTitle_AutomationName}" />
                      <TextBlock Text="{DynamicResource MainWindow_PlainTextNote_Text}" />
                      <TextBox x:Name="WorkspaceNoteBodyTextBox"
                               Text="{Binding Activities.DraftText, Mode=TwoWay}"
                               AcceptsReturn="True"
                               MinHeight="88"
                               MaxLength="16384"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_PortableNoteBody_AutomationName}" />
                      <Button x:Name="CreateWorkspaceNoteButton"
                              Content="{DynamicResource MainWindow_CreatePortableNote_Content}"
                              Command="{Binding Activities.CreateWorkspaceNoteCommand}"
                              IsEnabled="{Binding Activities.IsNoteCreationAvailable}"
                              AutomationProperties.Name="{DynamicResource MainWindow_CreatePortableNoteActivity_AutomationName}" />
                      <TextBlock Classes="secondary"
                                 Text="{Binding Activities.CreationStatus}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{DynamicResource MainWindow_PortableNoteCreationResult_AutomationName}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="6">
                        <TextBlock Classes="label" Text="{DynamicResource MainWindow_LocalActivities_Text}" />
                        <ListBox x:Name="ActivityList"
                                 ItemsSource="{Binding Activities.Activities}"
                                 SelectedItem="{Binding Activities.SelectedActivity, Mode=TwoWay}"
                                 MaxHeight="190"
                                 AutomationProperties.Name="{DynamicResource MainWindow_LocalSemanticActivities_AutomationName}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopActivitySnapshot">
                              <StackPanel Margin="8" Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="secondary"
                                           FontSize="11"
                                           Text="{Binding Kind}" />
                                <TextBlock Classes="secondary"
                                           FontSize="11"
                                           Text="{Binding Sensitivity}" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>

                      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="6">
                        <TextBlock Classes="label" Text="{DynamicResource MainWindow_AuthenticatedTarget_Text}" />
                        <ListBox x:Name="ActivityTargetList"
                                 ItemsSource="{Binding Activities.Targets}"
                                 SelectedItem="{Binding Activities.SelectedTarget, Mode=TwoWay}"
                                 MaxHeight="190"
                                 AutomationProperties.Name="{DynamicResource MainWindow_AuthenticatedSemanticActivityTargets_AutomationName}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopActivityTargetSnapshot">
                              <StackPanel Margin="8" Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="secondary"
                                           FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                           FontSize="11"
                                           Text="{Binding DeviceId}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource CoolGrayBrush}"
                            BorderThickness="1"
                            Padding="14"
                            AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowFallbackAvailability_AutomationName}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="label"
                                   Foreground="{StaticResource SafetyAmberBrush}"
                                   Text="{DynamicResource MainWindow_RemoteWindowExecutionStaysOnSource_Text_02}" />
                        <TextBlock Classes="label" Text="{DynamicResource MainWindow_RemoteWindowTarget_Text}" />
                        <ListBox x:Name="RemoteWindowTargetList"
                                 ItemsSource="{Binding Activities.RemoteWindowTargets}"
                                 SelectedItem="{Binding Activities.SelectedRemoteWindowTarget, Mode=TwoWay}"
                                 MaxHeight="132"
                                 AutomationProperties.Name="{DynamicResource MainWindow_AuthenticatedRemoteWindowTargetsForCurrentRole_AutomationName}"
                                 AutomationProperties.HelpText="{DynamicResource MainWindow_ViewOnlyRequiresMirrorViewingAuthorizationDrivingRequires_AutomationHelp}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopActivityTargetSnapshot">
                              <StackPanel Margin="8" Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="secondary"
                                           FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                           FontSize="11"
                                           Text="{Binding DeviceId}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ActivityDegradationStatusText"
                                   Classes="label"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   Text="{Binding RemoteWindow.FallbackStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_RemoteWindowFallbackAvailability_AutomationName_02}" />
                        <TextBlock x:Name="RemoteWindowFallbackDescriptionText"
                                   Classes="secondary"
                                   Text="{Binding RemoteWindow.FallbackDescription}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="StartRemoteWindowButton"
                                Content="{DynamicResource MainWindow_StartRemoteWindow_Content}"
                                Command="{Binding RemoteWindow.StartRemoteWindowCommand}"
                                IsEnabled="{Binding RemoteWindow.IsFallbackStartAvailable}"
                                AutomationProperties.Name="{Binding RemoteWindow.FallbackStartAutomationName}"
                                AutomationProperties.HelpText="{Binding RemoteWindow.FallbackDescription}" />
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource SafetyAmberBrush}"
                            BorderThickness="2"
                            Padding="14"
                            AutomationProperties.Name="{DynamicResource MainWindow_SemanticHandoffPreview_AutomationName}">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="ActivityPreviewStatusText"
                                   Classes="label"
                                   Foreground="{StaticResource SafetyAmberBrush}"
                                   Text="{Binding Activities.PreviewStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SemanticHandoffPreviewStatus_AutomationName}" />
                        <TextBlock Text="{Binding Activities.PreviewDescription}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ActivityDataDisclosureText"
                                   Classes="secondary"
                                   Text="{Binding Activities.DataDisclosure}"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SemanticHandoffDataDisclosure_AutomationName}" />
                        <Button x:Name="ActivityHandoffButton"
                                Content="{DynamicResource MainWindow_HandOffCopy_Content}"
                                Command="{Binding Activities.HandoffCommand}"
                                IsEnabled="{Binding Activities.IsHandoffAvailable}"
                                AutomationProperties.Name="{DynamicResource MainWindow_ConfirmSemanticHandoffCopy_AutomationName}"
                                AutomationProperties.HelpText="{DynamicResource MainWindow_CreatesASemanticCopyOnTheSelectedAuthenticated_AutomationHelp}" />
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource SignalRedBrush}"
                            BorderThickness="2"
                            Padding="14"
                            AutomationProperties.Name="{DynamicResource MainWindow_SemanticMovePreview_AutomationName}">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="ActivityMovePreviewStatusText"
                                   Classes="label"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   Text="{Binding Activities.MovePreviewStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SemanticMovePreviewStatus_AutomationName}" />
                        <TextBlock Text="{Binding Activities.MovePreviewDescription}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="ActivityMoveButton"
                                Content="{DynamicResource MainWindow_MoveAfterTargetAck_Content}"
                                Command="{Binding Activities.MoveCommand}"
                                IsEnabled="{Binding Activities.IsMoveAvailable}"
                                AutomationProperties.Name="{DynamicResource MainWindow_ConfirmSemanticMoveAfterTargetAcknowledgement_AutomationName}"
                                AutomationProperties.HelpText="{DynamicResource MainWindow_ResumesTheActivityOnTheSelectedAuthenticatedTarget_AutomationHelp}" />
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource SignalRedBrush}"
                            BorderThickness="4,1,1,1"
                            Padding="14"
                            AutomationProperties.Name="{DynamicResource MainWindow_ExactConfirmationDestructiveReplaceWorkflow_AutomationName}">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="label"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   Text="{DynamicResource MainWindow_ReplaceExactConfirmation_Text}" />
                        <TextBlock Classes="secondary"
                                   Text="{DynamicResource MainWindow_QueryAPurposeScopedPayloadFreeTargetInventory_Text}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="ReviewReplaceTargetsButton"
                                Content="{DynamicResource MainWindow_LoadRefreshReplaceTargets_Content}"
                                Command="{Binding Activities.RefreshReplaceTargetsCommand}"
                                IsEnabled="{Binding Activities.IsReplaceInventoryAvailable}"
                                AutomationProperties.Name="{DynamicResource MainWindow_LoadOrRefreshReplaceTargetInventory_AutomationName}"
                                AutomationProperties.HelpText="{DynamicResource MainWindow_QueriesEligibleSameKindTargetSnapshotsFromThe_AutomationHelp}" />
                        <TextBlock x:Name="ReplaceInventoryStatusText"
                                   Classes="label"
                                   Text="{Binding Activities.ReplaceInventoryStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_ReplaceTargetInventoryStatus_AutomationName}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.ReplaceInventoryDescription}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_ReplaceTargetInventoryRecoveryGuidance_AutomationName}" />
                        <Grid ColumnDefinitions="5*,7*">
                          <TextBlock Grid.Column="0"
                                     Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding Activities.ReplaceInventoryCoverage}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_ReplaceTargetInventoryCoverage_AutomationName}" />
                          <TextBlock Grid.Column="1"
                                     Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="10"
                                     Text="{Binding Activities.ReplaceInventoryCapturedAt, StringFormat={StaticResource MainWindow_Format_Captured}}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_ReplaceTargetInventoryCaptureTime_AutomationName}" />
                        </Grid>
                        <ListBox x:Name="ReplaceTargetList"
                                 ItemsSource="{Binding Activities.ReplaceTargets}"
                                 SelectedItem="{Binding Activities.SelectedReplaceTarget, Mode=TwoWay}"
                                 MaxHeight="190"
                                 AutomationProperties.Name="{DynamicResource MainWindow_ReplaceEligibleActivitiesOnSelectedTargetDevice_AutomationName}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopReplaceTargetSnapshot">
                              <Grid Margin="8" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                  <TextBlock FontWeight="SemiBold"
                                             Text="{Binding Title}"
                                             TextWrapping="Wrap" />
                                  <TextBlock Classes="secondary"
                                             FontSize="11"
                                             Text="{Binding Kind}" />
                                  <TextBlock Classes="secondary"
                                             FontSize="11"
                                             Text="{Binding PlacementSlot, StringFormat={StaticResource MainWindow_Format_Placement}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            HorizontalAlignment="Right"
                                            Spacing="3">
                                  <TextBlock Classes="label"
                                             Text="{Binding Revision, StringFormat={StaticResource MainWindow_Format_Revision}}" />
                                  <TextBlock Classes="secondary"
                                             FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                             FontSize="9"
                                             Text="{Binding DescriptorDigest}"
                                             MaxWidth="150"
                                             TextTrimming="CharacterEllipsis"
                                             AutomationProperties.Name="{DynamicResource MainWindow_TargetDescriptorDigest_AutomationName}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <Border IsVisible="{Binding Activities.IsReplacePreviewVisible}"
                                BorderBrush="{StaticResource SignalRedBrush}"
                                BorderThickness="1"
                                Padding="12"
                                AutomationProperties.Name="{DynamicResource MainWindow_ExactDestructiveReplaceComparison_AutomationName}">
                          <StackPanel Spacing="10">
                            <TextBlock Classes="label"
                                       Foreground="{StaticResource SignalRedBrush}"
                                       Text="{Binding Activities.ReplacePreviewStatus}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource MainWindow_ReplacePreviewStatus_AutomationName}" />
                            <Grid ColumnDefinitions="5*,Auto,7*">
                              <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="label" Text="{DynamicResource MainWindow_Incoming_Text}" />
                                <TextBlock x:Name="ReplaceIncomingDescriptionText"
                                           Text="{Binding Activities.ReplaceIncomingDescription}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{DynamicResource MainWindow_IncomingReplaceActivity_AutomationName}" />
                              </StackPanel>
                              <Border Grid.Column="1"
                                      Margin="10,0"
                                      BorderBrush="{StaticResource SignalRedBrush}"
                                      BorderThickness="1,0,0,0" />
                              <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="label"
                                           Foreground="{StaticResource SignalRedBrush}"
                                           Text="{DynamicResource MainWindow_ReplacedTarget_Text}" />
                                <TextBlock x:Name="ReplaceTargetDescriptionText"
                                           Text="{Binding Activities.ReplaceTargetDescription}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{DynamicResource MainWindow_ExactActivityThatWouldBeReplaced_AutomationName}" />
                              </StackPanel>
                            </Grid>
                            <CheckBox x:Name="ReplaceConfirmationCheckBox"
                                      IsChecked="{Binding Activities.HasAcknowledgedReplace, Mode=TwoWay}"
                                      IsEnabled="{Binding Activities.IsReplaceConfirmationAvailable}"
                                      AutomationProperties.Name="{Binding Activities.ReplaceConfirmationAutomationName}"
                                      AutomationProperties.HelpText="{DynamicResource MainWindow_ConfirmationAppliesOnlyToTheCurrentlyDisplayedDevice_AutomationHelp}">
                              <TextBlock Text="{Binding Activities.ReplaceConfirmationDescription}"
                                         TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock x:Name="ReplaceActivationStatusText"
                                       Classes="label"
                                       Foreground="{StaticResource SignalRedBrush}"
                                       Text="{Binding Activities.ReplaceActivationStatus}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource MainWindow_DestructiveReplaceActivationStatus_AutomationName}" />
                            <Button x:Name="DestructiveReplaceButton"
                                    Content="{DynamicResource MainWindow_ReplaceSelectedActivity_Content}"
                                    Command="{Binding Activities.ReplaceCommand}"
                                    IsEnabled="{Binding Activities.IsDestructiveReplaceAvailable}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_ReplaceSelectedTargetActivityAfterExactConfirmation_AutomationName}"
                                    AutomationProperties.HelpText="{DynamicResource MainWindow_RevalidatesTheExactTargetIdRevisionDescriptorDigest_AutomationHelp}" />
                            <Border BorderBrush="{StaticResource SignalRedBrush}"
                                    BorderThickness="1"
                                    Padding="10"
                                    IsVisible="{Binding Activities.IsReplaceOperationResultVisible}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_DestructiveReplaceResultAndRecoveryGuidance_AutomationName}">
                              <StackPanel Spacing="6">
                                <TextBlock x:Name="ReplaceOperationStatusText"
                                           Classes="label"
                                           Foreground="{StaticResource SignalRedBrush}"
                                           Text="{Binding Activities.ReplaceOperationStatus}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{DynamicResource MainWindow_DestructiveReplaceOperationStatus_AutomationName}" />
                                <TextBlock Classes="secondary"
                                           Text="{Binding Activities.ReplaceOperationDescription}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{DynamicResource MainWindow_DestructiveReplaceOutcomeAndRecoveryGuidance_AutomationName}" />
                                <Grid ColumnDefinitions="Auto,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="10"
                                      RowSpacing="3">
                                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="secondary" Text="{DynamicResource MainWindow_Operation_Text}" />
                                  <TextBlock Grid.Row="0" Grid.Column="1" Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding Activities.ReplaceOperationId}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_ReplaceOperationId_AutomationName}" />
                                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="secondary" Text="{DynamicResource MainWindow_Correlation_Text}" />
                                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding Activities.ReplaceOperationCorrelationId}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_ReplaceCorrelationId_AutomationName}" />
                                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="secondary" Text="{DynamicResource MainWindow_Reason_Text}" />
                                  <TextBlock Grid.Row="2" Grid.Column="1" Classes="secondary" Text="{Binding Activities.ReplaceOperationReason}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_ReplaceResultReason_AutomationName}" />
                                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="secondary" Text="{DynamicResource MainWindow_Occurred_Text}" />
                                  <TextBlock Grid.Row="3" Grid.Column="1" Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding Activities.ReplaceOperationOccurredAt}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_ReplaceReceiptTime_AutomationName}" />
                                  <TextBlock Grid.Row="4" Grid.Column="0" Classes="secondary" Text="{DynamicResource MainWindow_Capsule_Text}" />
                                  <TextBlock Grid.Row="4" Grid.Column="1" Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding Activities.ReplaceOperationCapsule}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_ReplaceUndoCapsuleId_AutomationName}" />
                                  <TextBlock Grid.Row="5" Grid.Column="0" Classes="secondary" Text="{DynamicResource MainWindow_UndoExpires_Text}" />
                                  <TextBlock Grid.Row="5" Grid.Column="1" Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding Activities.ReplaceOperationUndoExpiry}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource MainWindow_ReplaceUndoCapsuleExpiry_AutomationName}" />
                                </Grid>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource SafetyAmberBrush}"
                            BorderThickness="1"
                            Padding="14"
                            AutomationProperties.Name="{DynamicResource MainWindow_TargetLocalReplaceReceiptAndRecoveryState_AutomationName}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="label"
                                   Foreground="{StaticResource SafetyAmberBrush}"
                                   Text="{DynamicResource MainWindow_ReplaceRecoveryTargetLocalUndo_Text}" />
                        <TextBlock x:Name="ReplaceRecoveryStatusText"
                                   Classes="label"
                                   Text="{Binding Activities.ReplaceRecoveryStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryStatus_AutomationName}" />
                        <TextBlock Text="{Binding Activities.ReplaceRecoveryDescription}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryGuidance_AutomationName}" />
                        <Grid ColumnDefinitions="5*,7*">
                          <TextBlock Grid.Column="0"
                                     Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding Activities.ReplaceRecoveryCoverage}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryRecordCoverage_AutomationName}" />
                          <TextBlock Grid.Column="1"
                                     Classes="secondary"
                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                     FontSize="10"
                                     Text="{Binding Activities.ReplaceRecoveryCapturedAt, StringFormat={StaticResource MainWindow_Format_Snapshot}}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoverySnapshotTime_AutomationName}" />
                        </Grid>
                        <ListBox x:Name="ReplaceRecoveryList"
                                 ItemsSource="{Binding Activities.ReplaceRecoveryItems}"
                                 SelectedItem="{Binding Activities.SelectedReplaceRecoveryItem, Mode=TwoWay}"
                                 MaxHeight="260"
                                 AutomationProperties.Name="{DynamicResource MainWindow_TargetLocalReplaceAndUndoRecoveryRecords_AutomationName}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopReplaceRecoveryItem">
                              <Border Margin="4"
                                      BorderBrush="{StaticResource CoolGrayBrush}"
                                      BorderThickness="1"
                                      Padding="10">
                                <StackPanel Spacing="4">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Classes="label"
                                               Text="{Binding Kind}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="label"
                                               Text="{Binding State}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryRecordState_AutomationName}" />
                                  </Grid>
                                  <TextBlock Classes="secondary"
                                             Text="{Binding Reason, StringFormat={StaticResource MainWindow_Format_Reason}}" />
                                  <SelectableTextBlock Classes="secondary"
                                                       FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                       FontSize="10"
                                                       Text="{Binding OperationId, StringFormat={StaticResource MainWindow_Format_Operation}}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryOperationId_AutomationName}" />
                                  <SelectableTextBlock Classes="secondary"
                                                       FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                       FontSize="10"
                                                       Text="{Binding CorrelationId, StringFormat={StaticResource MainWindow_Format_Correlation}}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryCorrelationId_AutomationName}" />
                                  <TextBlock Classes="secondary"
                                             Text="{Binding Participants}"
                                             TextWrapping="Wrap" />
                                  <TextBlock Classes="secondary"
                                             Text="{Binding Activities}"
                                             TextWrapping="Wrap" />
                                  <SelectableTextBlock Classes="secondary"
                                                       FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                       FontSize="10"
                                                       Text="{Binding Capsule, StringFormat={StaticResource MainWindow_Format_Capsule}}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryCapsuleId_AutomationName}" />
                                  <TextBlock Classes="secondary"
                                             Text="{Binding Timestamp}"
                                             TextWrapping="Wrap" />
                                  <TextBlock Classes="label"
                                             Text="{Binding Undo}"
                                             TextWrapping="Wrap"
                                             AutomationProperties.Name="{DynamicResource MainWindow_ReplaceRecoveryUndoAvailability_AutomationName}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <Border BorderBrush="{StaticResource SignalRedBrush}"
                                BorderThickness="1"
                                Padding="12"
                                AutomationProperties.Name="{DynamicResource MainWindow_SelectedTargetLocalUndoAction_AutomationName}">
                          <StackPanel Spacing="8">
                            <TextBlock x:Name="TargetLocalUndoStatusText"
                                       Classes="label"
                                       Foreground="{StaticResource SignalRedBrush}"
                                       Text="{Binding Activities.TargetLocalUndoStatus}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource MainWindow_TargetLocalUndoStatus_AutomationName}" />
                            <TextBlock Text="{Binding Activities.TargetLocalUndoDescription}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource MainWindow_TargetLocalUndoOutcomeGuidance_AutomationName}" />
                            <TextBlock Classes="secondary"
                                       FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                       FontSize="10"
                                       Text="{Binding Activities.TargetLocalUndoConfirmationDescription}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource MainWindow_ExactTargetLocalUndoBinding_AutomationName}" />
                            <CheckBox x:Name="TargetLocalUndoConfirmationCheckBox"
                                      IsChecked="{Binding Activities.HasAcknowledgedTargetLocalUndo, Mode=TwoWay}"
                                      IsEnabled="{Binding Activities.IsTargetLocalUndoConfirmationAvailable}"
                                      AutomationProperties.Name="{Binding Activities.TargetLocalUndoConfirmationAutomationName}"
                                      AutomationProperties.HelpText="{DynamicResource MainWindow_ConfirmationAppliesOnlyToTheSelectedCapsuleBoth_AutomationHelp}">
                              <TextBlock Text="{DynamicResource MainWindow_IReviewedThisExactCapsuleAndWantTo_Text}"
                                         TextWrapping="Wrap" />
                            </CheckBox>
                            <Button x:Name="TargetLocalUndoButton"
                                    Content="{DynamicResource MainWindow_UndoSelectedReplace_Content}"
                                    Command="{Binding Activities.TargetLocalUndoCommand}"
                                    IsEnabled="{Binding Activities.IsTargetLocalUndoAvailable}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_ActivateTheConfirmedTargetLocalUndo_AutomationName}"
                                    AutomationProperties.HelpText="{DynamicResource MainWindow_WritesAProtectedPendingRecordBeforeOneExact_AutomationHelp}" />
                            <Grid ColumnDefinitions="*,*">
                              <TextBlock Grid.Column="0"
                                         Classes="secondary"
                                         Text="{Binding Activities.TargetLocalUndoReason, StringFormat={StaticResource MainWindow_Format_Reason}}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{DynamicResource MainWindow_TargetLocalUndoReason_AutomationName}" />
                              <TextBlock Grid.Column="1"
                                         Classes="secondary"
                                         FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                         FontSize="10"
                                         Text="{Binding Activities.TargetLocalUndoOccurredAt, StringFormat={StaticResource MainWindow_Format_Outcome}}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{DynamicResource MainWindow_TargetLocalUndoOutcomeTime_AutomationName}" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding Activities.IsReceiptVisible}"
                            BorderBrush="{StaticResource CoolGrayBrush}"
                            BorderThickness="1"
                            Padding="14"
                            AutomationProperties.Name="{DynamicResource MainWindow_SemanticActivityOperationReceipt_AutomationName}">
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="ActivityReceiptStatusText"
                                   Classes="label"
                                   Text="{Binding Activities.ReceiptStatus}"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SemanticActivityOperationReceiptStatus_AutomationName}" />
                        <TextBlock Text="{Binding Activities.ReceiptSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.ReceiptReason, StringFormat={StaticResource MainWindow_Format_Reason}}" />
                        <SelectableTextBlock Classes="secondary"
                                             FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                             FontSize="11"
                                             Text="{Binding Activities.ReceiptCorrelationId, StringFormat={StaticResource MainWindow_Format_Correlation}}"
                                             TextWrapping="Wrap"
                                             AutomationProperties.Name="{DynamicResource MainWindow_SemanticActivityOperationCorrelationId_AutomationName}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.ReceiptOccurredAt, StringFormat={StaticResource MainWindow_Format_Occurred}}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding Activities.UndoDescription}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource SafetyAmberBrush}"
                        BorderThickness="1"
                        Padding="14"
                        AutomationProperties.Name="{DynamicResource MainWindow_SceneRepositoryListInspectionDeleteAndExport_AutomationName}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label"
                               Foreground="{StaticResource SafetyAmberBrush}"
                               Text="{DynamicResource MainWindow_SceneRepositoryPrivateLocalStore_Text}" />
                    <TextBlock x:Name="SceneRepositoryStatusText"
                               Classes="label"
                               Text="{Binding SceneRepository.RepositoryStatus}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_SceneRepositoryStatus_AutomationName}" />
                    <TextBlock Classes="secondary"
                               Text="{Binding SceneRepository.RepositoryDescription}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_SceneRepositoryGuidance_AutomationName}" />
                    <Button x:Name="SceneRepositoryRefreshButton"
                            Content="{DynamicResource MainWindow_RefreshStoredScenes_Content}"
                            Command="{Binding SceneRepository.RefreshCommand}"
                            IsEnabled="{Binding SceneRepository.CanRefresh}"
                            AutomationProperties.Name="{DynamicResource MainWindow_RefreshTheStoredSceneList_AutomationName}"
                            AutomationProperties.HelpText="{DynamicResource MainWindow_ReadsTheProtectedLocalSceneRepositoryWithoutMutating_AutomationHelp}" />

                    <ListBox x:Name="SceneRepositoryList"
                             ItemsSource="{Binding SceneRepository.Scenes}"
                             SelectedItem="{Binding SceneRepository.SelectedScene, Mode=TwoWay}"
                             MaxHeight="280"
                             AutomationProperties.Name="{DynamicResource MainWindow_StoredScenes_AutomationName}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneRepositoryItemViewModel">
                          <Border Margin="4"
                                  BorderBrush="{StaticResource CoolGrayBrush}"
                                  BorderThickness="1"
                                  Padding="10">
                            <StackPanel Spacing="4">
                              <TextBlock FontWeight="SemiBold"
                                         Text="{Binding Name}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{Binding AutomationName}" />
                              <TextBlock Classes="secondary"
                                         Text="{Binding Summary}"
                                         TextWrapping="Wrap" />
                              <SelectableTextBlock Classes="secondary"
                                                   FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                   FontSize="10"
                                                   Text="{Binding SceneId}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="{DynamicResource MainWindow_StoredSceneId_AutomationName}" />
                              <TextBlock Classes="secondary"
                                         Text="{Binding GroupBinding}"
                                         TextWrapping="Wrap" />
                              <SelectableTextBlock Classes="secondary"
                                                   FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                   FontSize="10"
                                                   Text="{Binding SceneDigest, StringFormat={StaticResource MainWindow_Format_Digest}}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="{DynamicResource MainWindow_StoredSceneCanonicalDigest_AutomationName}" />
                              <TextBlock Classes="secondary"
                                         Text="{Binding SavedAt, StringFormat={StaticResource MainWindow_Format_Saved}}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Border BorderBrush="{StaticResource CoolGrayBrush}"
                            BorderThickness="1"
                            Padding="10"
                            AutomationProperties.Name="{DynamicResource MainWindow_StoredSceneOrderedItemInspection_AutomationName}">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="label"
                                   Text="{DynamicResource MainWindow_StoredSceneItemsLocalInspectionOnly_Text}" />
                        <ItemsControl x:Name="SceneRepositoryInspectList"
                                      ItemsSource="{Binding SceneRepository.InspectItems}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopSceneRepositoryPlanItem">
                              <Border Margin="3"
                                      Padding="8"
                                      BorderBrush="{StaticResource CoolGrayBrush}"
                                      BorderThickness="1">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding ItemLabel}" />
                                    <SelectableTextBlock Grid.Column="1"
                                                         Classes="secondary"
                                                         FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                         FontSize="10"
                                                         Text="{Binding ActivityId}"
                                                         TextWrapping="Wrap"
                                                         AutomationProperties.Name="{DynamicResource MainWindow_StoredSceneItemActivityId_AutomationName}" />
                                  </Grid>
                                  <TextBlock Classes="secondary"
                                             Text="{Binding Destination, StringFormat={StaticResource MainWindow_Format_Destination}}"
                                             TextWrapping="Wrap" />
                                  <TextBlock Classes="secondary"
                                             Text="{Binding SourceDisposition}"
                                             TextWrapping="Wrap" />
                                  <TextBlock Classes="secondary"
                                             Text="{Binding ConflictPolicy}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Button x:Name="SceneRepositorySelectButton"
                            Content="{DynamicResource MainWindow_SelectForApplyPreview_Content}"
                            Command="{Binding SceneRepository.SelectForApplyCommand}"
                            IsEnabled="{Binding SceneRepository.CanSelectForApply}"
                            AutomationProperties.Name="{DynamicResource MainWindow_SelectTheStoredSceneForApplyPreview_AutomationName}"
                            AutomationProperties.HelpText="{DynamicResource MainWindow_HandsTheStoredPlanToTheSceneApply_AutomationHelp}" />
                    <TextBlock x:Name="SceneRepositoryLifecycleStatusText"
                               Classes="label"
                               Text="{Binding SceneRepository.LifecycleStatus}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_SceneRepositoryLifecycleStatus_AutomationName}" />
                    <TextBlock Text="{Binding SceneRepository.LifecycleDescription}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_SceneRepositoryLifecycleGuidance_AutomationName}" />

                    <Button x:Name="SceneRepositoryBeginDeleteButton"
                            Content="{DynamicResource MainWindow_ReviewSceneDelete_Content}"
                            Command="{Binding SceneRepository.BeginDeleteCommand}"
                            IsEnabled="{Binding SceneRepository.CanBeginDelete}"
                            AutomationProperties.Name="{DynamicResource MainWindow_ReviewStoredSceneDeletion_AutomationName}" />
                    <Border IsVisible="{Binding SceneRepository.IsDeleteConfirmationVisible}"
                            BorderBrush="{StaticResource SignalRedBrush}"
                            BorderThickness="2"
                            Padding="12"
                            AutomationProperties.Name="{DynamicResource MainWindow_StoredSceneDeleteConfirmation_AutomationName}">
                      <StackPanel Spacing="10">
                        <TextBlock x:Name="SceneRepositoryDeleteConfirmationText"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding SceneRepository.DeleteConfirmation}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_ExactStoredSceneDeleteConfirmation_AutomationName}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button x:Name="SceneRepositoryCancelDeleteButton"
                                  Content="{DynamicResource MainWindow_Cancel_Content_07}"
                                  Command="{Binding SceneRepository.CancelDeleteCommand}"
                                  AutomationProperties.Name="{DynamicResource MainWindow_CancelStoredSceneDeletion_AutomationName}" />
                          <Button x:Name="SceneRepositoryConfirmDeleteButton"
                                  Background="{StaticResource SignalRedBrush}"
                                  BorderBrush="{StaticResource SignalRedBrush}"
                                  Foreground="{StaticResource GraphiteBrush}"
                                  Content="{DynamicResource MainWindow_DeleteScene_Content}"
                                  Command="{Binding SceneRepository.ConfirmDeleteCommand}"
                                  IsEnabled="{Binding SceneRepository.CanConfirmDelete}"
                                  AutomationProperties.Name="{DynamicResource MainWindow_DeleteTheStoredScenePermanently_AutomationName}"
                                  AutomationProperties.HelpText="{DynamicResource MainWindow_RemovesOnlyTheStoredPlanOnThisDevice_AutomationHelp}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Button x:Name="SceneRepositoryExportButton"
                            Content="{DynamicResource MainWindow_ExportRedactedSceneRecord_Content}"
                            Command="{Binding SceneRepository.ExportCommand}"
                            IsEnabled="{Binding SceneRepository.CanExport}"
                            AutomationProperties.Name="{DynamicResource MainWindow_ExportARedactedRecordOfTheSelectedStored_AutomationName}"
                            AutomationProperties.HelpText="{DynamicResource MainWindow_WritesIdentifiersRevisionsDigestsTimestampsAndPoliciesOnly_AutomationHelp}" />
                    <SelectableTextBlock x:Name="SceneRepositoryExportPathText"
                                         Classes="secondary"
                                         FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                         FontSize="10"
                                         Text="{Binding SceneRepository.ExportPath}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{DynamicResource MainWindow_SceneExportFilePath_AutomationName}" />
                    <SelectableTextBlock x:Name="SceneRepositoryExportPreviewText"
                                         Classes="secondary"
                                         FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                         FontSize="10"
                                         Text="{Binding SceneRepository.ExportPreview}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{DynamicResource MainWindow_RedactedSceneExportContent_AutomationName}" />
                  </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource SafetyAmberBrush}"
                        BorderThickness="1"
                        Padding="14"
                        AutomationProperties.Name="{DynamicResource MainWindow_SceneApplyPreviewConfirmationResultAndCompensation_AutomationName}">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label"
                                 Foreground="{StaticResource SafetyAmberBrush}"
                                 Text="{DynamicResource MainWindow_SceneApplyNonAtomic_Text}" />
                      <TextBlock x:Name="SceneApplyNameText"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Text="{Binding Scenes.SceneName}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{DynamicResource MainWindow_SelectedSceneName_AutomationName}" />
                      <TextBlock Classes="secondary"
                                 Text="{Binding Scenes.SceneDescription}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{DynamicResource MainWindow_SelectedSceneRevisionAndOrderedItemCount_AutomationName}" />
                    </StackPanel>

                    <Button x:Name="ScenePreviewButton"
                            Content="{DynamicResource MainWindow_PreviewCurrentSceneState_Content}"
                            Command="{Binding Scenes.PreviewCommand}"
                            IsEnabled="{Binding Scenes.CanPreview}"
                            AutomationProperties.Name="{DynamicResource MainWindow_PreviewSelectedSceneWithoutMutation_AutomationName}"
                            AutomationProperties.HelpText="{DynamicResource MainWindow_ReadsEverySavedSceneItemInOrderAnd_AutomationHelp}" />
                    <TextBlock x:Name="ScenePreviewStatusText"
                               Classes="label"
                               Text="{Binding Scenes.PreviewStatus}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_ScenePreviewStatus_AutomationName}" />
                    <TextBlock Text="{Binding Scenes.PreviewDescription}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_ScenePreviewGuidance_AutomationName}" />
                    <TextBlock x:Name="ScenePreviewExpiryText"
                               Classes="secondary"
                               Text="{Binding Scenes.PreviewExpiry}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_ScenePreviewExpiryState_AutomationName}" />
                    <TextBlock x:Name="SceneStaleGroupWarningText"
                               Classes="label"
                               Foreground="{StaticResource SafetyAmberBrush}"
                               Text="{Binding Scenes.StaleGroupWarning}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_SceneStaleGroupWarning_AutomationName}" />

                    <ListBox x:Name="ScenePreviewList"
                             ItemsSource="{Binding Scenes.PreviewItems}"
                             MaxHeight="420"
                             AutomationProperties.Name="{DynamicResource MainWindow_OrderedSceneActionsAndBlockers_AutomationName}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DesktopSceneApplyItemViewModel">
                          <Border Margin="4"
                                  BorderBrush="{StaticResource CoolGrayBrush}"
                                  BorderThickness="1"
                                  Padding="10">
                            <StackPanel Spacing="5">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="label" Text="{Binding ItemLabel}" />
                                <SelectableTextBlock Grid.Column="1"
                                                     Classes="secondary"
                                                     FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                     FontSize="10"
                                                     Text="{Binding ActivityId}"
                                                     TextWrapping="Wrap"
                                                     AutomationProperties.Name="{DynamicResource MainWindow_SceneItemActivityId_AutomationName}" />
                                <TextBlock Grid.Column="2"
                                           Classes="label"
                                           Foreground="{StaticResource SafetyAmberBrush}"
                                           Text="{Binding Action}"
                                           AutomationProperties.Name="{DynamicResource MainWindow_ResolvedSceneItemAction_AutomationName}" />
                              </Grid>
                              <TextBlock Classes="label"
                                         Text="{Binding SourceDisposition}"
                                         AutomationProperties.Name="{DynamicResource MainWindow_SceneItemSourceDisposition_AutomationName}" />
                              <TextBlock Classes="secondary"
                                         Text="{Binding SourceDescription, StringFormat={StaticResource MainWindow_Format_Source}}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="secondary"
                                         Text="{Binding DestinationDescription, StringFormat={StaticResource MainWindow_Format_Destination}}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="secondary"
                                         Text="{Binding Reason, StringFormat={StaticResource MainWindow_Format_State}}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{DynamicResource MainWindow_SceneItemBlockerOrReadinessReason_AutomationName}" />
                              <ComboBox ItemsSource="{Binding SourceOptions}"
                                        SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                        IsVisible="{Binding CanSelectSource}"
                                        AutomationProperties.Name="{DynamicResource MainWindow_SelectOneExactSourceForThisSceneItem_AutomationName}" />
                              <Border BorderBrush="{StaticResource SignalRedBrush}"
                                      BorderThickness="1"
                                      Padding="8"
                                      IsVisible="{Binding IsReplace}">
                                <StackPanel Spacing="5">
                                  <TextBlock Classes="label"
                                             Foreground="{StaticResource SignalRedBrush}"
                                             Text="{DynamicResource MainWindow_ExactReplaceTargetPreservedInUndoCapsule_Text}" />
                                  <SelectableTextBlock Classes="secondary"
                                                       FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                                       FontSize="10"
                                                       Text="{Binding ReplaceTargetDescription}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="{DynamicResource MainWindow_ExactSceneReplaceTargetBinding_AutomationName}" />
                                  <CheckBox IsChecked="{Binding IsReplaceConfirmed, Mode=TwoWay}"
                                            AutomationProperties.Name="{Binding ReplaceConfirmationAutomationName}"
                                            AutomationProperties.HelpText="{DynamicResource MainWindow_ConfirmsOnlyThisExactTargetDeviceActivityRevision_AutomationHelp}">
                                    <TextBlock Text="{DynamicResource MainWindow_IExplicitlyConfirmThisExactDestructiveReplacement_Text}"
                                               TextWrapping="Wrap" />
                                  </CheckBox>
                                </StackPanel>
                              </Border>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="SceneRepreviewButton"
                            Content="{DynamicResource MainWindow_RegenerateCompletePreviewWithSelectedSources_Content}"
                            Command="{Binding Scenes.RepreviewCommand}"
                            IsEnabled="{Binding Scenes.CanRepreview}"
                            AutomationProperties.Name="{DynamicResource MainWindow_RegenerateCompleteScenePreviewWithExactSourceSelections_AutomationName}" />
                    <CheckBox x:Name="SceneApplyConfirmationCheckBox"
                              IsChecked="{Binding Scenes.HasAcknowledgedApply, Mode=TwoWay}"
                              AutomationProperties.Name="{DynamicResource MainWindow_ConfirmThisExactExpiringScenePreview_AutomationName}"
                              AutomationProperties.HelpText="{DynamicResource MainWindow_DoesNotReplaceAnyPerItemDestructiveConfirmation_AutomationHelp}">
                      <TextBlock Text="{DynamicResource MainWindow_IReviewedTheOrderedActionsBlockersSourceDispositions_Text}"
                                 TextWrapping="Wrap" />
                    </CheckBox>
                    <Button x:Name="SceneApplyButton"
                            Content="{DynamicResource MainWindow_ApplyConfirmedSceneItems_Content}"
                            Command="{Binding Scenes.ApplyCommand}"
                            IsEnabled="{Binding Scenes.CanApply}"
                            AutomationProperties.Name="{DynamicResource MainWindow_ApplyTheExactConfirmedScenePreview_AutomationName}"
                            AutomationProperties.HelpText="{DynamicResource MainWindow_ProcessesSavedOrderSequentiallyThisIsNotAn_AutomationHelp}" />

                    <Border BorderBrush="{StaticResource CoolGrayBrush}"
                            BorderThickness="1"
                            Padding="10"
                            AutomationProperties.Name="{DynamicResource MainWindow_TruthfulPerItemSceneApplyResult_AutomationName}">
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="SceneApplyResultStatusText"
                                   Classes="label"
                                   Text="{Binding Scenes.ResultStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SceneApplyOverallResult_AutomationName}" />
                        <TextBlock Text="{Binding Scenes.ResultDescription}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SceneApplyPartialResultGuidance_AutomationName}" />
                        <ListBox x:Name="SceneApplyResultList"
                                 ItemsSource="{Binding Scenes.ResultItems}"
                                 MaxHeight="320"
                                 AutomationProperties.Name="{DynamicResource MainWindow_OrderedSceneApplyItemOutcomes_AutomationName}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopSceneApplyResultItem">
                              <Border Margin="3" Padding="8" BorderBrush="{StaticResource CoolGrayBrush}" BorderThickness="1">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding ItemLabel}" />
                                    <SelectableTextBlock Grid.Column="1" Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding ActivityId}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="{Binding Outcome}" AutomationProperties.Name="{DynamicResource MainWindow_SceneItemOutcome_AutomationName}" />
                                  </Grid>
                                  <TextBlock Classes="secondary" Text="{Binding Action, StringFormat={StaticResource MainWindow_Format_Action}}" />
                                  <TextBlock Classes="secondary" Text="{Binding Reason, StringFormat={StaticResource MainWindow_Format_Reason}}" />
                                  <SelectableTextBlock Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding OperationId, StringFormat={StaticResource MainWindow_Format_Operation}}" TextWrapping="Wrap" />
                                  <SelectableTextBlock Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding CorrelationId, StringFormat={StaticResource MainWindow_Format_Correlation}}" TextWrapping="Wrap" />
                                  <TextBlock Classes="secondary" Text="{Binding OccurredAt, StringFormat={StaticResource MainWindow_Format_Occurred}}" />
                                  <SelectableTextBlock Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding UndoCapsule, StringFormat={StaticResource MainWindow_Format_UndoCapsule}}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource SignalRedBrush}"
                            BorderThickness="1"
                            Padding="10"
                            AutomationProperties.Name="{DynamicResource MainWindow_ExplicitSafeSceneCompensation_AutomationName}">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="label"
                                   Foreground="{StaticResource SignalRedBrush}"
                                   Text="{DynamicResource MainWindow_ExplicitCompensationReplaceOnly_Text}" />
                        <CheckBox x:Name="SceneCompensationConfirmationCheckBox"
                                  IsChecked="{Binding Scenes.HasAcknowledgedCompensation, Mode=TwoWay}"
                                  AutomationProperties.Name="{DynamicResource MainWindow_ConfirmExplicitReverseOrderSceneReplaceCompensation_AutomationName}">
                          <TextBlock Text="{DynamicResource MainWindow_AttemptOnlyEligibleCommittedPreserveSourceReplaceUndo_Text}"
                                     TextWrapping="Wrap" />
                        </CheckBox>
                        <Button x:Name="SceneCompensateButton"
                                Content="{DynamicResource MainWindow_AttemptEligibleReplaceUndo_Content}"
                                Command="{Binding Scenes.CompensateCommand}"
                                IsEnabled="{Binding Scenes.CanCompensate}"
                                AutomationProperties.Name="{DynamicResource MainWindow_AttemptExplicitSafeSceneCompensation_AutomationName}" />
                        <TextBlock x:Name="SceneCompensationStatusText"
                                   Classes="label"
                                   Text="{Binding Scenes.CompensationStatus}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SceneCompensationOverallStatus_AutomationName}" />
                        <TextBlock Text="{Binding Scenes.CompensationDescription}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource MainWindow_SceneCompensationPartialResultGuidance_AutomationName}" />
                        <ListBox x:Name="SceneCompensationResultList"
                                 ItemsSource="{Binding Scenes.CompensationItems}"
                                 MaxHeight="260"
                                 AutomationProperties.Name="{DynamicResource MainWindow_ReverseOrderSceneCompensationItemOutcomes_AutomationName}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopSceneCompensationItem">
                              <Border Margin="3" Padding="8" BorderBrush="{StaticResource CoolGrayBrush}" BorderThickness="1">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding ItemLabel}" />
                                    <SelectableTextBlock Grid.Column="1" Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding CapsuleId}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="{Binding Outcome}" AutomationProperties.Name="{DynamicResource MainWindow_SceneCompensationItemOutcome_AutomationName}" />
                                  </Grid>
                                  <TextBlock Classes="secondary" Text="{Binding TargetDeviceId, StringFormat={StaticResource MainWindow_Format_TargetDevice}}" />
                                  <TextBlock Classes="secondary" Text="{Binding Reason, StringFormat={StaticResource MainWindow_Format_Reason}}" />
                                  <SelectableTextBlock Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding OperationId, StringFormat={StaticResource MainWindow_Format_Operation}}" TextWrapping="Wrap" />
                                  <SelectableTextBlock Classes="secondary" FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono" FontSize="10" Text="{Binding CorrelationId, StringFormat={StaticResource MainWindow_Format_Correlation}}" TextWrapping="Wrap" />
                                  <TextBlock Classes="secondary" Text="{Binding OccurredAt, StringFormat={StaticResource MainWindow_Format_Occurred}}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#20262A"
                    BorderBrush="{StaticResource CoolGrayBrush}"
                    BorderThickness="1"
                    Padding="24"
                    Margin="12,0,0,0">
              <StackPanel MinHeight="310" Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_LocalNetwork_Text}" />
                  <TextBlock Classes="heading" FontSize="27" Text="{DynamicResource MainWindow_TrustedDevices_Text}" />
                </StackPanel>
                <Border BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,16,0,0">
                  <StackPanel Spacing="10">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{Binding TrustedDevices.Status}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding TrustedDevices.Status}" />
                    <TextBlock Classes="secondary"
                               Text="{Binding TrustedDevices.StatusDescription}" />
                    <TextBlock Classes="label"
                               Foreground="{StaticResource SafetyAmberBrush}"
                               Text="{Binding TrustedDevices.Protection}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{DynamicResource MainWindow_TrustStoreProtection_AutomationName}" />
                    <TextBlock Classes="secondary"
                               IsVisible="{Binding TrustedDevices.IsEmpty}"
                               Text="{Binding TrustedDevices.RecoveryAction}" />

                    <StackPanel IsVisible="{Binding TrustedDevices.IsTrustAvailable}"
                                Spacing="12">
                      <TextBlock x:Name="DeviceEmptyState"
                                 IsVisible="{Binding TrustedDevices.IsEmpty}"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Text="{DynamicResource MainWindow_NoPairedDeviceHasAPersistedTrustRecord_Text}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{DynamicResource MainWindow_TrustedDevicesStatusNoPairedDevices_AutomationName}" />

                      <ListBox x:Name="TrustedDeviceList"
                               ItemsSource="{Binding TrustedDevices.Devices}"
                               SelectedItem="{Binding TrustedDevices.SelectedDevice, Mode=TwoWay}"
                               MaxHeight="220"
                               AutomationProperties.Name="{DynamicResource MainWindow_PairedDevices_AutomationName}">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="8" Spacing="3">
                              <TextBlock FontWeight="SemiBold"
                                         Text="{Binding DisplayName}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="secondary"
                                         FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                         FontSize="11"
                                         Text="{Binding DeviceId}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="secondary"
                                         FontSize="11"
                                         Text="{Binding CapabilitySummary}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <Border IsVisible="{Binding TrustedDevices.HasSelection}"
                              IsEnabled="{Binding TrustedDevices.CanEditSelectedPeer}"
                              BorderBrush="{StaticResource CoolGrayBrush}"
                              BorderThickness="1"
                              Padding="14">
                        <StackPanel Spacing="10">
                          <TextBlock Classes="label" Text="{DynamicResource MainWindow_SelectedTrustRecord_Text}" />
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding TrustedDevices.SelectedDevice.DisplayName}"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="{DynamicResource MainWindow_SelectedPairedDevice_AutomationName}" />
                          <TextBlock Classes="label" Text="{DynamicResource MainWindow_DeviceId_Text_02}" />
                          <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                               FontSize="11"
                                               Text="{Binding TrustedDevices.SelectedDevice.DeviceId}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{DynamicResource MainWindow_SelectedPeerDeviceId_AutomationName}" />
                          <TextBlock Classes="label" Text="{DynamicResource MainWindow_IdentityFingerprint_Text_03}" />
                          <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                               FontSize="11"
                                               Text="{Binding TrustedDevices.SelectedDevice.Fingerprint}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{DynamicResource MainWindow_SelectedPeerIdentityFingerprint_AutomationName}" />
                          <TextBlock Classes="secondary"
                                     FontSize="11"
                                     Text="{Binding TrustedDevices.SelectedDevice.VerifiedAt, StringFormat={StaticResource MainWindow_Format_Verified}}"
                                     AutomationProperties.Name="{DynamicResource MainWindow_TrustVerificationTime_AutomationName}" />

                          <TextBlock Classes="label" Text="{DynamicResource MainWindow_LocalCapabilityGrant_Text}" />
                          <TextBlock Classes="secondary"
                                     FontSize="12"
                                     Text="{DynamicResource MainWindow_AGrantPermitsAClassOfPeerRequest_Text}" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantActivityOffer, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_ActivityOfferAllowThisPeerToSendActivities_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToOfferActivities_AutomationName}" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantActivityReceive, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_ActivityReceiveAllowThisPeerToReceiveActivities_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToReceiveActivities_AutomationName}" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantActivityReplace, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_ActivityReplaceReplaceActivities_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToReplaceActivities_AutomationName}" />
                          <CheckBox x:Name="GrantActivitySwapCheckBox"
                                    IsChecked="{Binding TrustedDevices.GrantActivitySwap, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_ActivitySwapParticipateInAtomicActivitySwaps_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToParticipateInAtomicActivitySwaps_AutomationName}" />
                          <CheckBox x:Name="GrantMirrorViewCheckBox"
                                    IsChecked="{Binding TrustedDevices.GrantMirrorView, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_MirrorViewViewMirroredActivities_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToViewMirroredActivities_AutomationName}" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantMirrorDrive, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_MirrorDriveDriveMirroredActivities_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToDriveMirroredActivities_AutomationName}" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantFileReceive, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_FileReceiveReceiveFiles_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToReceiveFiles_AutomationName}" />
                          <CheckBox IsChecked="{Binding TrustedDevices.GrantSceneApply, Mode=TwoWay}"
                                    Content="{DynamicResource MainWindow_SceneApplyApplyScenes_Content}"
                                    AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToApplyScenes_AutomationName}" />

                          <Button x:Name="SaveCapabilitiesButton"
                                  Content="{DynamicResource MainWindow_SaveCapabilities_Content}"
                                  Command="{Binding TrustedDevices.SaveCapabilitiesCommand}"
                                  AutomationProperties.Name="{DynamicResource MainWindow_SavePeerCapabilities_AutomationName}" />

                          <Button x:Name="ReviewRevokeButton"
                                  Content="{DynamicResource MainWindow_ReviewRevoke_Content}"
                                  Command="{Binding TrustedDevices.BeginRevokeCommand}"
                                  AutomationProperties.Name="{DynamicResource MainWindow_ReviewDeviceRevocation_AutomationName}" />
                          <Border IsVisible="{Binding TrustedDevices.IsRevokeConfirmationVisible}"
                                  BorderBrush="{StaticResource SignalRedBrush}"
                                  BorderThickness="2"
                                  Padding="12"
                                  AutomationProperties.Name="{DynamicResource MainWindow_DeviceRevocationConfirmation_AutomationName}">
                            <StackPanel Spacing="10">
                              <TextBlock Foreground="{StaticResource SignalRedBrush}"
                                         FontWeight="SemiBold"
                                         Text="{Binding TrustedDevices.RevokeConfirmation}"
                                         TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{DynamicResource MainWindow_Cancel_Content_08}"
                                        Command="{Binding TrustedDevices.CancelRevokeCommand}"
                                        AutomationProperties.Name="{DynamicResource MainWindow_CancelDeviceRevocation_AutomationName}" />
                                <Button x:Name="ConfirmRevokeButton"
                                        Background="{StaticResource SignalRedBrush}"
                                        BorderBrush="{StaticResource SignalRedBrush}"
                                        Foreground="{StaticResource GraphiteBrush}"
                                        Content="{DynamicResource MainWindow_RevokeDevice_Content}"
                                        Command="{Binding TrustedDevices.ConfirmRevokeCommand}"
                                        AutomationProperties.Name="{DynamicResource MainWindow_RevokePairedDevice_AutomationName}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                      <TextBlock x:Name="TrustMutationStatusText"
                                 Classes="secondary"
                                 Text="{Binding TrustedDevices.MutationStatus}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{DynamicResource MainWindow_TrustMutationResult_AutomationName}" />
                      <TextBlock Classes="secondary"
                                 FontSize="12"
                                 Text="{Binding TrustedDevices.MutationDescription}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{DynamicResource MainWindow_TrustMutationDetails_AutomationName}" />
                      <Button x:Name="ExportTrustButton"
                              MinHeight="44"
                              Content="{DynamicResource MainWindow_ExportRedactedTrust_Content}"
                              Command="{Binding TrustedDevices.ExportTrustCommand}"
                              AutomationProperties.Name="{DynamicResource MainWindow_ExportRedactedTrustInventory_AutomationName}"
                              AutomationProperties.HelpText="{DynamicResource MainWindow_WritesAnOwnerOnlyExportWithoutPeerNames_AutomationHelp}" />
                      <TextBlock Classes="secondary"
                                 FontSize="11"
                                 Text="{Binding TrustedDevices.TrustExportPath}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{DynamicResource MainWindow_TrustExportPath_AutomationName}" />
                      <SelectableTextBlock Classes="secondary"
                                           FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                           FontSize="10"
                                           MaxHeight="110"
                                           Text="{Binding TrustedDevices.TrustExportPreview}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{DynamicResource MainWindow_RedactedTrustExportPreview_AutomationName}" />
                    </StackPanel>

                    <TextBlock Classes="secondary"
                               FontSize="12"
                               Text="{Binding Pairing.Status}"
                               AutomationProperties.Name="{DynamicResource MainWindow_PairingReadiness_AutomationName}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>

          <Border IsVisible="{Binding Pairing.HasPendingPrompt}"
                  Background="{StaticResource SteelBrush}"
                  BorderBrush="{StaticResource SafetyAmberBrush}"
                  BorderThickness="2"
                  Padding="28"
                  AutomationProperties.Name="{DynamicResource MainWindow_PairingConfirmationRequired_AutomationName}">
            <Grid ColumnDefinitions="7*,5*">
              <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,24,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label"
                             Foreground="{StaticResource SafetyAmberBrush}"
                             Text="{DynamicResource MainWindow_PairingConfirmation_Text}" />
                  <TextBlock Classes="heading"
                             FontSize="30"
                             Text="{Binding Pairing.PeerDisplayName}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{DynamicResource MainWindow_PairingPeerName_AutomationName}" />
                  <TextBlock Classes="secondary"
                             Text="{DynamicResource MainWindow_CompareThisCodeOnBothDevicesAMatching_Text}" />
                </StackPanel>

                <TextBlock x:Name="PairingCodeValue"
                           Classes="heading"
                           FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                           FontSize="46"
                           Foreground="{StaticResource SafetyAmberBrush}"
                           LetterSpacing="4"
                           Text="{Binding Pairing.PairingCode}"
                           AutomationProperties.Name="{DynamicResource MainWindow_PairingCode_AutomationName}" />

                <CheckBox x:Name="PairingCodeConfirmation"
                          IsChecked="{Binding Pairing.IsCodeConfirmed, Mode=TwoWay}"
                          Content="{DynamicResource MainWindow_IComparedThisCodeOnBothDevices_Content}"
                          AutomationProperties.Name="{DynamicResource MainWindow_IComparedThePairingCodeOnBothDevices_AutomationName}"
                          AutomationProperties.HelpText="{DynamicResource MainWindow_RequiredBeforeConfirmingPairing_AutomationHelp}" />

                <Border BorderBrush="{StaticResource CoolGrayBrush}"
                        BorderThickness="1"
                        Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource MainWindow_LocalCapabilityGrant_Text_02}" />
                    <TextBlock Classes="secondary"
                               Text="{DynamicResource MainWindow_StartWithNoAccessTheseOptionsDoNot_Text}" />
                    <CheckBox x:Name="GrantActivityOfferCheckBox"
                              IsChecked="{Binding Pairing.GrantActivityOffer, Mode=TwoWay}"
                              Content="{DynamicResource MainWindow_AllowThisPeerToSendActivitiesToThis_Content}"
                              AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToOfferActivities_AutomationName_02}" />
                    <CheckBox x:Name="GrantActivityReceiveCheckBox"
                              IsChecked="{Binding Pairing.GrantActivityReceive, Mode=TwoWay}"
                              Content="{DynamicResource MainWindow_AllowThisPeerToReceiveActivitiesFromThis_Content}"
                              AutomationProperties.Name="{DynamicResource MainWindow_AllowPeerToReceiveActivities_AutomationName_02}" />
                    <TextBlock Classes="secondary"
                               FontSize="12"
                               Text="{Binding Pairing.CapabilitySummary}"
                               AutomationProperties.Name="{DynamicResource MainWindow_SelectedPairingCapabilities_AutomationName}" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button x:Name="RejectPairingButton"
                          MinWidth="150"
                          Content="{DynamicResource MainWindow_Reject_Content}"
                          Command="{Binding Pairing.RejectPairingCommand}"
                          AutomationProperties.Name="{DynamicResource MainWindow_RejectPairing_AutomationName}" />
                  <Button x:Name="AcceptPairingButton"
                          MinWidth="190"
                          Background="{StaticResource SafetyAmberBrush}"
                          BorderBrush="{StaticResource SafetyAmberBrush}"
                          Foreground="{StaticResource GraphiteBrush}"
                          FontWeight="Bold"
                          Content="{DynamicResource MainWindow_ConfirmPairing_Content}"
                          IsEnabled="{Binding Pairing.CanAcceptPairing}"
                          Command="{Binding Pairing.AcceptPairingCommand}"
                          AutomationProperties.Name="{DynamicResource MainWindow_ConfirmPairing_AutomationName}"
                          AutomationProperties.HelpText="{DynamicResource MainWindow_EnabledOnlyAfterTheCodeComparisonIsConfirmed_AutomationHelp}" />
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="1"
                      BorderBrush="{StaticResource CoolGrayBrush}"
                      BorderThickness="1,0,0,0"
                      Padding="24,0,0,0">
                <StackPanel Spacing="12">
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_VerifiedRequestDetails_Text}" />
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_DeviceId_Text_03}" />
                  <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                       FontSize="12"
                                       Text="{Binding Pairing.PeerDeviceId}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource MainWindow_PairingPeerDeviceId_AutomationName}" />
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_IdentityFingerprint_Text_04}" />
                  <SelectableTextBlock FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono"
                                       FontSize="12"
                                       Text="{Binding Pairing.PeerFingerprint}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{DynamicResource MainWindow_PairingPeerIdentityFingerprint_AutomationName}" />
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_Protocol_Text}" />
                  <TextBlock Text="{Binding Pairing.PairingProtocol}"
                             AutomationProperties.Name="{DynamicResource MainWindow_PairingProtocolVersion_AutomationName}" />
                  <TextBlock Classes="label" Text="{DynamicResource MainWindow_Expires_Text}" />
                  <TextBlock Text="{Binding Pairing.PairingExpiresAt}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="{DynamicResource MainWindow_PairingRequestExpiry_AutomationName}" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

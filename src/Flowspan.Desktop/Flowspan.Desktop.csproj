<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Accessible cross-platform desktop composition root for Flowspan.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>Flowspan</Product>
    <RepositoryUrl>https://github.com/happys2333/flowspan</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FlowspanDistributionBuild)' == 'true'">
    <RuntimeFrameworkVersion>$(FlowspanRuntimePackVersion)</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Flowspan.Application/Flowspan.Application.csproj" />
    <ProjectReference Include="../Flowspan.Diagnostics/Flowspan.Diagnostics.csproj" />
    <ProjectReference Include="../Flowspan.Platform.Linux/Flowspan.Platform.Linux.csproj" />
    <ProjectReference Include="../Flowspan.Platform.MacOS/Flowspan.Platform.MacOS.csproj" />
    <ProjectReference Include="../Flowspan.Platform.Windows/Flowspan.Platform.Windows.csproj" />
    <ProjectReference Include="../Flowspan.Security/Flowspan.Security.csproj" />
    <ProjectReference Include="../Flowspan.Transport/Flowspan.Transport.csproj" />
    <ProjectReference Include="../Flowspan.Transport.Mdns/Flowspan.Transport.Mdns.csproj" />
  </ItemGroup>
  <Target Name="RemoveDistributionSymbols"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(FlowspanDistributionBuild)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
